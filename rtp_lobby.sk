command /rtp:
    description: Отправляет на Выживание
    trigger:
        send "&aОтправляем вас на Выживание..." to player
        
        # Выдаем временную метку через LuckPerms (на 1 минуту)
        execute console command "lp user %player% permission settemp rtp.pending true 1m"
        
        # Перекидываем на Выживание
        send player to server "makakawo777-world"
