# ==========================================
# Заполнение через WorldEdit (Топорик)
# ==========================================

command /fill:
    permission: skript.admin
    trigger:
        send "&8&m--------------------------------" to player
        send "&eВыберите блок для заполнения (введите цифру):" to player
        send "&f1. Барьер (barrier)" to player
        send "&f2. Бедрок (bedrock)" to player
        send "&f3. Камень (stone)" to player
        send "&f4. Стекло (glass)" to player
        send "&f5. Воздух (air)" to player
        send "&8&m--------------------------------" to player
        
        set {fill::stage::%player's uuid%} to 1
        stop

on chat:
    if {fill::stage::%player's uuid%} is set:
        cancel event
        
        if message is "cancel":
            delete {fill::stage::%player's uuid%}
            delete {fill::x1::%player's uuid%}
            delete {fill::y1::%player's uuid%}
            delete {fill::z1::%player's uuid%}
            delete {fill::x2::%player's uuid%}
            delete {fill::y2::%player's uuid%}
            delete {fill::z2::%player's uuid%}
            send "&cОтменено." to player
            stop

        # --- ЭТАП 1: Выбор блока ---
        if {fill::stage::%player's uuid%} is 1:
            set {_block} to none
            if message is "1":
                set {_block} to "barrier"
            else if message is "2":
                set {_block} to "bedrock"
            else if message is "3":
                set {_block} to "stone"
            else if message is "4":
                set {_block} to "glass"
            else if message is "5":
                set {_block} to "air"
            else:
                send "&cНеверный выбор. Введите 1-5:" to player
                stop
                
            if {_block} is set:
                set {fill::block::%player's uuid%} to {_block}
                delete {fill::x1::%player's uuid%}
                delete {fill::y1::%player's uuid%}
                delete {fill::z1::%player's uuid%}
                delete {fill::x2::%player's uuid%}
                delete {fill::y2::%player's uuid%}
                delete {fill::z2::%player's uuid%}
                
                give 1 of wooden axe to player
                set name of player's tool to "&e&lТопор заполнения"
                
                send "&aБлок выбран: %message%!" to player
                send "&e1. Ударьте ЛКМ по первому углу (низ)." to player
                send "&e2. Ударьте ЛКМ по второму углу (верх)." to player
                send "&e3. Скрипт сам выделит зону и заполнит её!" to player
                
                set {fill::stage::%player's uuid%} to 2
                stop

# --- ЛКМ (Ломание блока) ---
on block break:
    if name of player's tool is "&e&lТопор заполнения":
        if {fill::stage::%player's uuid%} is 2:
            cancel event
            
            # Если Точка 1 еще не стоит
            if {fill::x1::%player's uuid%} is not set:
                set {fill::x1::%player's uuid%} to x-coord of event-block
                set {fill::y1::%player's uuid%} to y-coord of event-block
                set {fill::z1::%player's uuid%} to z-coord of event-block
                
                send "&aТочка 1 (низ) установлена! Теперь ударьте ЛКМ по второму углу." to player
                stop
            
            # Если Точка 1 уже стоит, а Точка 2 нет
            if {fill::x2::%player's uuid%} is not set:
                set {fill::x2::%player's uuid%} to x-coord of event-block
                set {fill::y2::%player's uuid%} to y-coord of event-block
                set {fill::z2::%player's uuid%} to z-coord of event-block
                
                send "&aТочка 2 (верх) установлена. Заполняем..." to player
                
                # Отправляем команды WorldEdit от лица игрока
                # 1. Выделяем точки
                execute player command "//pos1 %{fill::x1::%player's uuid%}%,%{fill::y1::%player's uuid%}%,%{fill::z1::%player's uuid%}%"
                execute player command "//pos2 %{fill::x2::%player's uuid%}%,%{fill::y2::%player's uuid%}%,%{fill::z2::%player's uuid%}%"
                
                # 2. Заполняем зону
                execute player command "//set %{fill::block::%player's uuid%}%"
                
                send "&aГотово! Зона заполнена." to player
                
                # Очищаем переменные (кроме выбранного блока, чтобы можно было сразу делать новые зоны)
                delete {fill::stage::%player's uuid%}
                delete {fill::x1::%player's uuid%}
                delete {fill::y1::%player's uuid%}
                delete {fill::z1::%player's uuid%}
                delete {fill::x2::%player's uuid%}
                delete {fill::y2::%player's uuid%}
                delete {fill::z2::%player's uuid%}
