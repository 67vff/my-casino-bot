command /swapenchants:
    permission: skript.admin
    trigger:
        # Получаем предмет из главной руки (тот, что держим)
        set {_item1} to player's tool
        
        # Получаем предмет из второй руки (оффхенд)
        set {_item2} to player's off hand tool
        
        # Проверка: в руках должны быть предметы
        if {_item1} is air:
            send "&cВозьмите инструмент (с которого снять чары) в главную руку!" to player
            stop
        if {_item2} is air:
            send "&cВозьмите второй инструмент (на который наложить чары) во вторую руку!" to player
            stop

        # Проверка: это должны быть инструменты (добавил проверку по имени материала)
        if name of {_item1} does not contain "pickaxe" and name of {_item1} does not contain "axe" and name of {_item1} does not contain "shovel" and name of {_item1} does not contain "hoe":
            send "&cПредмет в главной руке не является инструментом!" to player
            stop
        if name of {_item2} does not contain "pickaxe" and name of {_item2} does not contain "axe" and name of {_item2} does not contain "shovel" and name of {_item2} does not contain "hoe":
            send "&cПредмет во второй руке не является инструментом!" to player
            stop

        # Перебираем ВСЕ ванильные зачарования
        # Если на первом предмете есть чары, мы накладываем их на второй
        loop all enchantments:
            set {_ench} to loop-value
            if {_item1} is enchanted with {_ench}:
                set {_lvl} to level of {_ench} on {_item1}
                enchant {_item2} with {_ench} at {_lvl}
        
        # Возвращаем предметы игроку
        set player's tool to {_item2}
        set player's off hand tool to {_item1}
        
        send "&aУспешно! Все ванильные зачарования перенесены." to player
        send "&7(Примечание: кастомные чары из EnchantsPlus могут не переноситься)" to player
