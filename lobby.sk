# 1. Команда /spawn (телепорт на спавн)
command /spawn:
    trigger:
        execute console command "essentials:spawn %player%"
        send "&aВы телепортированы на спавн!" to player

# 2. Команда /rtp (телепорт в рандом)
command /rtp:
    trigger:
        send "&aИщем безопасное место..." to player
        wait 1 second
        execute console command "tpr %player%"
        send "&aВы телепортированы в случайное место!" to player

# 3. Автоматический телепорт в рандом при первом входе (если нужно)
on first join:
    wait 3 seconds
    if player doesn't have permission "admin.tp":
        execute console command "tpr %player%"

# 4. Команда выдачи предметов (для админов)
command /giveitem <text> [<number>]:
    permission: server.give
    trigger:
        give <number> of <text> to player
        send "&aВыдан предмет: &e%<text>% &aв количестве: &e%<number>%" to player
