# Команда для установки спавна (только для админов)
command /setspawn:
    permission: skript.admin
    trigger:
        set {lobby_spawn} to location of player
        send "&aТочка спавна на Лобби успешно установлена!" to player

# Команда для телепорта на спавн
command /spawn:
    trigger:
        if {lobby_spawn} is set:
            teleport player to {lobby_spawn}
            send "&aВы телепортированы на спавн." to player
        else:
            send "&cСпавн еще не установлен!" to player

# Автоматический телепорт на спавн при входе
on join:
    wait 1 second
    if {lobby_spawn} is set:
        teleport player to {lobby_spawn}
