# ==========================================
# Поэтапное переименование предметов
# ==========================================

command /renameme:
    trigger:
        if player's tool is air:
            send "&cВозьмите предмет в руку!" to player
            stop
        
        set {rename::item::%player's uuid%} to player's tool
        set {rename::stage::%player's uuid%} to 1
        
        send "&8&m--------------------------------" to player
        send "&e[1/4] Введите в чат желаемое название предмета (или напишите &ccancel&e):" to player
        send "&8&m--------------------------------" to player
        stop

# --- ЭТАП 1: Ловим название ---
on chat:
    if {rename::stage::%player's uuid%} is 1:
        cancel event
        
        if message is "cancel":
            delete {rename::stage::%player's uuid%}
            delete {rename::item::%player's uuid%}
            send "&cПереименование отменено." to player
            stop
        
        set {rename::text::%player's uuid%} to message
        set {rename::stage::%player's uuid%} to 2
        
        send "&8&m--------------------------------" to player
        send "&aНазвание сохранено: &f%message%" to player
        send "&e[2/4] Выберите цвет цифрой:" to player
        send "&f1. &cКрасный" to player
        send "&f2. &6Золотой" to player
        send "&f3. &aЗеленый" to player
        send "&f4. &bГолубой" to player
        send "&f5. &dРозовый" to player
        send "&f6. &5Фиолетовый" to player
        send "&f7. &fБелый" to player
        send "&f8. &7Серый" to player
        send "&f9. &eЖелтый" to player
        send "&8&m--------------------------------" to player
        stop

# --- ЭТАП 2: Ловим цвет ---
on chat:
    if {rename::stage::%player's uuid%} is 2:
        cancel event
        
        set {_color} to "&f"
        if message is "1":
            set {_color} to "&c"
        else if message is "2":
            set {_color} to "&6"
        else if message is "3":
            set {_color} to "&a"
        else if message is "4":
            set {_color} to "&b"
        else if message is "5":
            set {_color} to "&d"
        else if message is "6":
            set {_color} to "&5"
        else if message is "7":
            set {_color} to "&f"
        else if message is "8":
            set {_color} to "&7"
        else if message is "9":
            set {_color} to "&e"
        else:
            send "&cНеверный цвет. Введите цифру от 1 до 9:" to player
            stop
        
        set {rename::color::%player's uuid%} to {_color}
        set {rename::stage::%player's uuid%} to 3
        
        send "&8&m--------------------------------" to player
        send "&e[3/4] Выберите иконку для конца названия:" to player
        send "&f1. Кирка (⛏)" to player
        send "&f2. Топор (🪓)" to player
        send "&f3. Лопата (🪏)" to player
        send "&f4. Мотыга (🌾)" to player
        send "&f5. Меч (⚔)" to player
        send "&f6. Лук (🏹)" to player
        send "&f7. Звезда (✨)" to player
        send "&f8. Череп (💀)" to player
        send "&f9. Огонь (🔥)" to player
        send "&f10. Без иконки" to player
        send "&8&m--------------------------------" to player
        stop

# --- ЭТАП 3: Ловим иконку ---
on chat:
    if {rename::stage::%player's uuid%} is 3:
        cancel event
        
        set {_icon} to ""
        if message is "1":
            set {_icon} to " ⛏"
        else if message is "2":
            set {_icon} to " 🪓"
        else if message is "3":
            set {_icon} to " 🪏"
        else if message is "4":
            set {_icon} to " 🌾"
        else if message is "5":
            set {_icon} to " ⚔"
        else if message is "6":
            set {_icon} to " 🏹"
        else if message is "7":
            set {_icon} to " ✨"
        else if message is "8":
            set {_icon} to " 💀"
        else if message is "9":
            set {_icon} to " 🔥"
        else if message is "10":
            set {_icon} to ""
        else:
            send "&cНеверная иконка. Введите цифру от 1 до 10:" to player
            stop
        
        set {rename::icon::%player's uuid%} to {_icon}
        set {rename::stage::%player's uuid%} to 4
        
        send "&8&m--------------------------------" to player
        send "&e[4/4] Выберите шрифт цифрой:" to player
        send "&f1. &lЖирный" to player
        send "&f2. &oКурсив" to player
        send "&f3. &nПодчеркнутый" to player
        send "&f4. &mЗачеркнутый" to player
        send "&f5. &kМагия (обфускация)" to player
        send "&f6. Обычный" to player
        send "&8&m--------------------------------" to player
        stop

# --- ЭТАП 4: Ловим шрифт и собираем предмет ---
on chat:
    if {rename::stage::%player's uuid%} is 4:
        cancel event
        
        set {_font} to ""
        if message is "1":
            set {_font} to "&l"
        else if message is "2":
            set {_font} to "&o"
        else if message is "3":
            set {_font} to "&n"
        else if message is "4":
            set {_font} to "&m"
        else if message is "5":
            set {_font} to "&k"
        else if message is "6":
            set {_font} to ""
        else:
            send "&cНеверный шрифт. Введите цифру от 1 до 6:" to player
            stop
        
        # Собираем финальное название: Цвет + Шрифт + Название + Иконка
        set {_finalName} to "%{rename::color::%player's uuid%}%%{_font}%%{rename::text::%player's uuid%}%%{rename::icon::%player's uuid%}%"
        
        # Меняем имя предмету
        set name of {rename::item::%player's uuid%} to {_finalName}
        
        # Выдаем предмет обратно
        set player's tool to {rename::item::%player's uuid%}
        
        send "&8&m--------------------------------" to player
        send "&aГотово! Предмет переименован в: %{_finalName}%" to player
        send "&8&m--------------------------------" to player
        
        # Очищаем данные игрока
        delete {rename::stage::%player's uuid%}
        delete {rename::item::%player's uuid%}
        delete {rename::text::%player's uuid%}
        delete {rename::color::%player's uuid%}
        delete {rename::icon::%player's uuid%}
        stop
