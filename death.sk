on death:
    # 1. Отправляем сообщение
    send "&cВы умерли и отправляетесь на Лобби!" to victim
    
    # 2. Принудительно возрождаем игрока (убираем кнопку "Возродиться")
    force respawn victim
    
    # 3. Ждем полсекунды, чтобы сервер применил респавн
    wait 0.5 seconds
    
    # 4. Перекидываем на Лобби
    send victim to server "lobbi-12"
