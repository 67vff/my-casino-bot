# Скрипт для Выживания: телепорт новичков в рандом при первом входе

on first join:
    # Ждем 4 секунды, чтобы AuthMe пропустил игрока и он прогрузился
    wait 4 seconds
    
    # Проверяем, что это не админ (чтобы вас не кидало)
    if player doesn't have permission "admin.tp":
        # Выполняем команду рандомного телепорта от лица консоли (консоль имеет все права)
        execute console command "rtp %player%"
        send "&aДобро пожаловать на Выживание! Вы телепортированы в случайное место." to player
