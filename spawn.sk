command /spawn:
    description: Телепортирует на Лобби и на спавн
    trigger:
        # Отправляем игрока на Лобби (ID из velocity.toml)
        send player to server "lobbi-12"
        send "&aВы отправляетесь на спавн..." to player
        
        # Ждем 3 секунды для прогрузки
        wait 3 seconds
        
        # Телепортируем на координаты (86, 150, 14) лицом на север
        teleport player to location(86, 150, 14, world "world", -178.1, 1.6)
        send "&aВы телепортированы на спавн!" to player
