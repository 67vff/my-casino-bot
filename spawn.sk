command /spawn:
    description: Телепортирует на Лобби и на спавн
    trigger:
        # Отправляем игрока на сервер Лобби (стандартное имя "lobby")
        send player to server "lobby"
        send "&aВы отправляетесь на спавн..." to player
        
        # Ждем 3 секунды, чтобы клиент успел подключиться к Лобби
        wait 3 seconds
        
        # Телепортируем на координаты (лицом на север, как вы просили)
        teleport player to location(86, 150, 14, world "world", -178.1, 1.6)
        send "&aВы телепортированы на спавн!" to player
