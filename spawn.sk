# Чтобы случайно не кидало админов
on join:
    # Ждем 2 секунды, чтобы AuthMe пропустил игрока
    wait 2 seconds
    
    # Проверяем, что игрок не админ
    if player doesn't have permission "admin.tp":
        # Кидаем в рандом через Essentials
        execute console command "tpr %player%"
        send "&aВы телепортированы в случайное место на Выживании!" to player
