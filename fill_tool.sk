# ==========================================
# Умное заполнение зоны (пошагово в чате)
# ==========================================

command /fill:
    permission: skript.admin
    trigger:
        # Начинаем диалог
        set {fill::stage::%player's uuid%} to 1
        
        send "&8&m--------------------------------" to player
        send "&e[1/7] Введите ID блока, которым нужно заполнить (например: &fstone&e, &fbarrier&e, &fair&e)." to player
        send "&7(Чтобы отменить, напишите &ccancel&7)" to player
        send "&8&m--------------------------------" to player

# Ловим все сообщения игрока
on chat:
    # Проверяем, участвует ли игрок в заполнении
    if {fill::stage::%player's uuid%} is set:
        cancel event
        
        # Отмена
        if message is "cancel":
            delete {fill::stage::%player's uuid%}
            send "&cЗаполнение отменено." to player
            stop

        # ==========================================
        # ЭТАП 1: Блок
        # ==========================================
        if {fill::stage::%player's uuid%} is 1:
            set {_block} to message parsed as block
            if {_block} is not set:
                send "&cОшибка: Блок '&e%message%&c' не найден. Введите правильный ID (например, stone):" to player
                stop
            
            set {fill::block::%player's uuid%} to {_block}
            set {fill::stage::%player's uuid%} to 2
            
            send "&8&m--------------------------------" to player
            send "&aБлок выбран: &e%message%" to player
            send "&e[2/7] Введите координату &fX &eдля Угла 1 (от 1 до 10):" to player
            send "&8&m--------------------------------" to player
            stop

        # ==========================================
        # ЭТАП 2: X1
        # ==========================================
        if {fill::stage::%player's uuid%} is 2:
            if message is not a number:
                send "&cОшибка: Введите число (цифру)!" to player
                stop
            
            set {_num} to message parsed as number
            if {_num} < 1 or {_num} > 10:
                send "&cОшибка: Координата должна быть от 1 до 10!" to player
                stop
                
            set {fill::x1::%player's uuid%} to {_num}
            set {fill::stage::%player's uuid%} to 3
            
            send "&8&m--------------------------------" to player
            send "&e[3/7] Введите координату &fY &eдля Угла 1:" to player
            send "&8&m--------------------------------" to player
            stop

        # ==========================================
        # ЭТАП 3: Y1
        # ==========================================
        if {fill::stage::%player's uuid%} is 3:
            if message is not a number:
                send "&cОшибка: Введите число!" to player
                stop
            
            set {fill::y1::%player's uuid%} to message parsed as number
            set {fill::stage::%player's uuid%} to 4
            
            send "&8&m--------------------------------" to player
            send "&e[4/7] Введите координату &fZ &eдля Угла 1:" to player
            send "&8&m--------------------------------" to player
            stop

        # ==========================================
        # ЭТАП 4: Z1
        # ==========================================
        if {fill::stage::%player's uuid%} is 4:
            if message is not a number:
                send "&cОшибка: Введите число!" to player
                stop
            
            set {fill::z1::%player's uuid%} to message parsed as number
            set {fill::stage::%player's uuid%} to 5
            
            send "&8&m--------------------------------" to player
            send "&e[5/7] Введите координату &fX &eдля Угла 2:" to player
            send "&8&m--------------------------------" to player
            stop

        # ==========================================
        # ЭТАП 5: X2
        # ==========================================
        if {fill::stage::%player's uuid%} is 5:
            if message is not a number:
                send "&cОшибка: Введите число!" to player
                stop
            
            set {fill::x2::%player's uuid%} to message parsed as number
            set {fill::stage::%player's uuid%} to 6
            
            send "&8&m--------------------------------" to player
            send "&e[6/7] Введите координату &fY &eдля Угла 2:" to player
            send "&8&m--------------------------------" to player
            stop

        # ==========================================
        # ЭТАП 6: Y2
        # ==========================================
        if {fill::stage::%player's uuid%} is 6:
            if message is not a number:
                send "&cОшибка: Введите число!" to player
                stop
            
            set {fill::y2::%player's uuid%} to message parsed as number
            set {fill::stage::%player's uuid%} to 7
            
            send "&8&m--------------------------------" to player
            send "&e[7/7] Введите координату &fZ &eдля Угла 2:" to player
            send "&8&m--------------------------------" to player
            stop

        # ==========================================
        # ЭТАП 7: Z2 и ФИНАЛ
        # ==========================================
        if {fill::stage::%player's uuid%} is 7:
            if message is not a number:
                send "&cОшибка: Введите число!" to player
                stop
            
            set {fill::z2::%player's uuid%} to message parsed as number
            
            # Собираем координаты
            set {_loc1} to location({fill::x1::%player's uuid%}, {fill::y1::%player's uuid%}, {fill::z1::%player's uuid%}, player's world)
            set {_loc2} to location({fill::x2::%player's uuid%}, {fill::y2::%player's uuid%}, {fill::z2::%player's uuid%}, player's world)
            
            # Проверка на объем
            set {_dx} to abs({fill::x2::%player's uuid%} - {fill::x1::%player's uuid%}) + 1
            set {_dy} to abs({fill::y2::%player's uuid%} - {fill::y1::%player's uuid%}) + 1
            set {_dz} to abs({fill::z2::%player's uuid%} - {fill::z1::%player's uuid%}) + 1
            set {_volume} to {_dx} * {_dy} * {_dz}
            
            if {_volume} > 10000:
                send "&cЗона слишком большая (%{_volume}% блоков). Лимит: 10 000." to player
                send "&7Процесс отменен." to player
                delete {fill::stage::%player's uuid%}
                stop
            
            send "&8&m--------------------------------" to player
            send "&eЗаполнение... (%{_volume}% блоков)" to player
            
            # Заполняем
            loop blocks within {_loc1} to {_loc2}:
                set loop-block to {fill::block::%player's uuid%}
            
            send "&aГотово! Зона заполнена блоком &e%{fill::block::%player's uuid%}%" to player
            send "&8&m--------------------------------" to player
            
            # Очищаем данные
            delete {fill::stage::%player's uuid%}
            delete {fill::block::%player's uuid%}
            delete {fill::x1::%player's uuid%}
            delete {fill::y1::%player's uuid%}
            delete {fill::z1::%player's uuid%}
            delete {fill::x2::%player's uuid%}
            delete {fill::y2::%player's uuid%}
            delete {fill::z2::%player's uuid%}
            stop
