# ==========================================
# Заполнение зоны с выбором блока в чате
# ==========================================

# Переменные для выбора блока
# {fill::selected::%player's uuid%} - выбранный блок

command /fill:
    permission: skript.admin
    trigger:
        # Отправляем меню с выбором
        send "&8&m--------------------------------" to player
        send "&eВыберите блок для заполнения (введите цифру в чат):" to player
        send "&f1. Барьер (barrier)" to player
        send "&f2. Бедрок (bedrock)" to player
        send "&f3. Камень (stone)" to player
        send "&f4. Стекло (glass)" to player
        send "&f5. Воздух (air)" to player
        send "&8&m--------------------------------" to player
        
        # Начинаем диалог выбора
        set {fill::stage::%player's uuid%} to 1
        stop

# Ловим сообщение игрока с цифрой
on chat:
    # Проверяем, находится ли игрок на этапе выбора блока
    if {fill::stage::%player's uuid%} is 1:
        cancel event
        
        set {_block} to none
        
        # Проверяем, какую цифру ввели
        if message is "1":
            set {_block} to barrier
        else if message is "2":
            set {_block} to bedrock
        else if message is "3":
            set {_block} to stone
        else if message is "4":
            set {_block} to glass
        else if message is "5":
            set {_block} to air
        else:
            send "&cНеверный выбор! Введите цифру от 1 до 5 (или напишите 'cancel'):" to player
            stop
            
        # Если блок выбран успешно
        if {_block} is set:
            # Сохраняем блок
            set {fill::block::%player's uuid%} to {_block}
            
            # Выдаем топор
            give 1 of wooden axe to player
            set name of player's tool to "&e&lТопор заполнения"
            
            send "&8&m--------------------------------" to player
            send "&aБлок выбран: &e%message%" to player
            send "&eИнструкция:" to player
            send "&f1. &eУдарьте ЛКМ (левой кнопкой) по блоку — это будет &cниз&e." to player
            send "&f2. &eУдарьте ПКМ (правой кнопкой) по блоку — это будет &aверх&e." to player
            send "&f3. &eЗона заполнится автоматически!" to player
            send "&8&m--------------------------------" to player
            
            # Убираем метку выбора
            delete {fill::stage::%player's uuid%}
            stop

# ==========================================
# Обработка клика топором
# ==========================================

# ЛКМ (низ)
on left click with wooden axe:
    if name of player's tool is "&e&lТопор заполнения":
        cancel event
        if {fill::block::%player's uuid%} is not set:
            send "&cСначала выберите блок командой /fill!" to player
            stop
            
        set {fill::pos1::%player's uuid%} to location of event-block
        send "&aТочка 1 (низ) установлена: &e%x-coord of event-block%, %y-coord of event-block%, %z-coord of event-block%" to player
        checkFill(player)

# ПКМ (верх)
on right click with wooden axe:
    if name of player's tool is "&e&lТопор заполнения":
        cancel event
        if {fill::block::%player's uuid%} is not set:
            send "&cСначала выберите блок командой /fill!" to player
            stop
            
        set {fill::pos2::%player's uuid%} to location of event-block
        send "&aТочка 2 (верх) установлена: &e%x-coord of event-block%, %y-coord of event-block%, %z-coord of event-block%" to player
        checkFill(player)

# ==========================================
# Функция заполнения
# ==========================================
function checkFill(p: player):
    if {fill::pos1::%{_p}'s uuid%} is set and {fill::pos2::%{_p}'s uuid%} is set:
        # Считаем объем
        set {_x1} to x-coord of {fill::pos1::%{_p}'s uuid%}
        set {_y1} to y-coord of {fill::pos1::%{_p}'s uuid%}
        set {_z1} to z-coord of {fill::pos1::%{_p}'s uuid%}
        
        set {_x2} to x-coord of {fill::pos2::%{_p}'s uuid%}
        set {_y2} to y-coord of {fill::pos2::%{_p}'s uuid%}
        set {_z2} to z-coord of {fill::pos2::%{_p}'s uuid%}
        
        set {_dx} to abs({_x2} - {_x1}) + 1
        set {_dy} to abs({_y2} - {_y1}) + 1
        set {_dz} to abs({_z2} - {_z1}) + 1
        set {_volume} to {_dx} * {_dy} * {_dz}
        
        if {_volume} > 10000:
            send "&cЗона слишком большая (%{_volume}% блоков). Лимит: 10 000." to {_p}
            send "&7Сбросьте точки и попробуйте снова." to {_p}
            delete {fill::pos1::%{_p}'s uuid%}
            delete {fill::pos2::%{_p}'s uuid%}
            stop
        
        send "&eЗаполнение зоны (%{_volume}% блоков)..." to {_p}
        
        # Заполняем
        loop blocks within {fill::pos1::%{_p}'s uuid%} to {fill::pos2::%{_p}'s uuid%}:
            set loop-block to {fill::block::%{_p}'s uuid%}
            
        send "&aГотово! Зона заполнена." to {_p}
        
        # Очищаем точки (но оставляем выбранный блок)
        delete {fill::pos1::%{_p}'s uuid%}
        delete {fill::pos2::%{_p}'s uuid%}
