# ==========================================
# Заполнение зоны по координатам (без топора)
# ==========================================

command /pos1:
    permission: skript.admin
    trigger:
        # Берем блок, на который смотрит игрок
        set {_target} to target block of player
        if {_target} is air:
            send "&cНаведитесь на блок!" to player
            stop
        
        set {fill::pos1::%player's uuid%} to location of {_target}
        send "&aТочка 1 (низ) установлена: &e%x-coord of {_target}%, %y-coord of {_target}%, %z-coord of {_target}%" to player

command /pos2:
    permission: skript.admin
    trigger:
        # Берем блок, на который смотрит игрок
        set {_target} to target block of player
        if {_target} is air:
            send "&cНаведитесь на блок!" to player
            stop
            
        set {fill::pos2::%player's uuid%} to location of {_target}
        send "&aТочка 2 (верх) установлена: &e%x-coord of {_target}%, %y-coord of {_target}%, %z-coord of {_target}%" to player

command /fill <string>:
    permission: skript.admin
    trigger:
        if {fill::pos1::%player's uuid%} is not set:
            send "&cСначала установите Точку 1 командой /pos1 (наведитесь на блок)!" to player
            stop
        if {fill::pos2::%player's uuid%} is not set:
            send "&cСначала установите Точку 2 командой /pos2 (наведитесь на блок)!" to player
            stop
        
        # Проверка на размер (чтобы не залагать сервер)
        set {_x1} to x-coord of {fill::pos1::%player's uuid%}
        set {_y1} to y-coord of {fill::pos1::%player's uuid%}
        set {_z1} to z-coord of {fill::pos1::%player's uuid%}
        
        set {_x2} to x-coord of {fill::pos2::%player's uuid%}
        set {_y2} to y-coord of {fill::pos2::%player's uuid%}
        set {_z2} to z-coord of {fill::pos2::%player's uuid%}
        
        set {_dx} to abs({_x2} - {_x1}) + 1
        set {_dy} to abs({_y2} - {_y1}) + 1
        set {_dz} to abs({_z2} - {_z1}) + 1
        set {_volume} to {_dx} * {_dy} * {_dz}
        
        if {_volume} > 10000:
            send "&cЗона слишком большая! Максимум 10 000 блоков (сейчас %{_volume}%)" to player
            stop
        
        # Проверяем, существует ли такой блок
        set {_blockType} to arg-1 parsed as block
        if {_blockType} is not set:
            send "&cБлок '&e%arg-1%&c' не найден! Проверьте название (например, stone, barrier, air)." to player
            stop
        
        send "&eЗаполнение зоны (%{_volume}% блоков)..." to player
        
        # Заполняем
        loop blocks within {fill::pos1::%player's uuid%} to {fill::pos2::%player's uuid%}:
            set loop-block to {_blockType}
        
        send "&aГотово! Зона заполнена блоком &e%arg-1%" to player
