 * Вагонетка Шахтёра с ТНТ: обычная вагонетка + ТНТ Стилер соответствующего уровня.
 * Уровень результата наследуется от стилера.
 */
public class CraftRecipes {

    public static void register(JavaPlugin plugin,
                                ItemStack stiler1, ItemStack cart1,
                                ItemStack stiler2, ItemStack cart2,
                                ItemStack stiler3, ItemStack cart3) {
        registerCart(plugin, "miner_cart_1", cart1, stiler1);
        registerCart(plugin, "miner_cart_2", cart2, stiler2);
        registerCart(plugin, "miner_cart_3", cart3, stiler3);
    }

    private static void registerCart(JavaPlugin plugin, String key, ItemStack result, ItemStack stiler) {
        ShapelessRecipe recipe = new ShapelessRecipe(new NamespacedKey(plugin, key), result.clone());
        recipe.addIngredient(new RecipeChoice.ExactChoice(stiler.clone()));
        recipe.addIngredient(Material.MINECART);
        Bukkit.addRecipe(recipe);
    }
