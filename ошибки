#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
mario_hack.py — LEGO Mario: перекраска в зелёный.

  python3 mario_hack.py discover --yes
  python3 mario_hack.py probe --yes
  python3 mario_hack.py sweep --yes --stop-at 0x50
  python3 mario_hack.py header --yes                    # снять заголовок образа с фигурки
  python3 mario_hack.py green --yes                     # перебор команд установки цвета
  python3 mario_hack.py green --yes --only 37 --hold    # закрепить найденную комбинацию
  python3 mario_hack.py patch fw.bin --out green.bin    # red->green + пересчёт CRC
  python3 mario_hack.py oad green.bin --yes --force     # залить (необратимо-ish)
"""

import argparse
import asyncio
import json
import random
import struct
import sys
import time
from collections import defaultdict
from bleak import BleakScanner, BleakClient

IDENTIFY = "f000ffc1-0451-4000-b000-000000000000"   # OAD image identify
BLOCK    = "f000ffc2-0451-4000-b000-000000000000"   # OAD image block
COUNT    = "f000ffc3-0451-4000-b000-000000000000"   # OAD image count
STATUS   = "f000ffc4-0451-4000-b000-000000000000"   # OAD status
EXTCTRL  = "f000ffc5-0451-4000-b000-000000000000"   # ext ctrl (команды)

NAMES = {u.lower(): n for u, n in
         ((IDENTIFY, "IDENT"), (BLOCK, "BLOCK"), (COUNT, "COUNT"),
          (STATUS, "STATUS"), (EXTCTRL, "EXT"))}

KNOWN_GOOD = [0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x10, 0x11, 0x13]
SILENT = [0x28]

# --- кандидаты для установки цвета. RGB-зелёный = 00 FF 00, GRB-зелёный = FF 00 00 ---
GREEN_CMDS = [0x10, 0x11, 0x13, 0x09, 0x06, 0x08, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F, 0x12, 0x14, 0x15]
GREEN_PAYLOADS = [
    b"\x00\xff\x00",            # rgb
    b"\xff\x00\x00",            # grb
    b"\x00\x00\xff\x00",        # idx + rgb
    b"\x00\x00\xff\x00\xff",
    b"\x01\x00\xff\x00",        # idx 1 + rgb
    b"\x00\xff\x00\x00\xff",
    b"\x00\x00\xff",
    b"\xff\x00\x00\xff",
]

OAD_STATUS = {0x00: "OK", 0x01: "CRC_ERR", 0x02: "FLASH_ERR", 0x03: "BUFFER_OFL",
              0x04: "ALREADY_STARTED", 0x05: "NOT_STARTED", 0x06: "INCOMPLETE",
              0x07: "BIM_CRC_ERR", 0x08: "BIM_FLASH_ERR", 0x09: "BIM_OFL",
              0x0A: "TIMEOUT", 0x0C: "IMG_HDR_ERR", 0x0D: "BIM_VERIFY_ERR"}


def short(u):
    return NAMES.get(u.lower(), u[:8])


def log(m=""):
    print(m, flush=True)


def crc16(data):
    """CRC16-CCITT, poly 0x1021, init 0xFFFF — как в BIM."""
    crc = 0xFFFF
    for b in data:
        crc ^= b << 8
        for _ in range(8):
            crc = ((crc << 1) ^ 0x1021) & 0xFFFF if crc & 0x8000 else (crc << 1) & 0xFFFF
    return crc


def build_header(img, uid, template=None, ver=0x10, len_value=None):
    """16-байтовый заголовок OAD. Шаблон — собственный заголовок устройства, если есть."""
    c = crc16(img)
    h = bytearray(template) if template and len(template) >= 16 else bytearray(16)
    h[0:2] = struct.pack("<H", c)
    h[2:4] = struct.pack("<H", (~c) & 0xFFFF)
    h[4] = ver
    h[5] = (len_value if len_value is not None else (len(img) // 4)) & 0xFF
    h[6:8] = b"\xff\xff"
    h[8:12] = struct.pack("<I", uid & 0xFFFFFFFF)
    h[12:14] = b"\x00\x00"
    h[14] = 0x01          # imgVld
    h[15] = 0x01          # imgType = app
    return bytes(h)


def parse_header(h):
    c0, c1, ver, ln, rfu, uid, addr, vld, typ = struct.unpack("<HHBBHIHBB", h[:16])
    return dict(crc0=c0, crc1=c1, crc_ok=(c1 == (~c0) & 0xFFFF), ver=ver, len=ln,
                rfu=rfu, uid=uid, addr=addr, vld=vld, typ=typ)


class Mario:
    def __init__(self, client, args):
        self.c = client
        self.args = args
        self.rng = random.Random(args.seed)
        self.props = {}
        self.dump = {"ts": time.time(), "events": []}
        self.own_hdr = None
        self.cur = "idle"
        self.counts = defaultdict(lambda: defaultdict(int))
        self.total = 0
        self.suppressed = 0
        self.dropped = False
        self.hdr_seen = asyncio.Event()
        self.status_q = asyncio.Queue()

    # ---------- транспорт ----------
    def on_notify(self, sender, data):
        raw = bytes(data)
        name = short(sender.uuid)
        h = raw.hex(" ")
        self.total += 1
        self.dump["events"].append({"t": time.time(), "cmd": self.cur, "ch": name, "data": h})

        n = self.counts[self.cur][h]
        self.counts[self.cur][h] = n + 1
        if n < self.args.spam_cap:
            log(f"    [{name}] {h}")
        elif n == self.args.spam_cap:
            log(f"    [{name}] {h} ...дальше подавляю")
            self.suppressed += 1
        else:
            self.suppressed += 1

        if sender.uuid.lower() == STATUS.lower() and raw:
            self.status_q.put_nowait(raw[0])
        if sender.uuid.lower() == IDENTIFY.lower() and self.own_hdr is None and len(raw) >= 16:
            self.own_hdr = raw[:16]
            self.hdr_seen.set()
            log(f"    >>> ЗАГОЛОВОК УСТРОЙСТВА: {raw[:16].hex(' ')}")

    async def setup(self):
        for ch in self.c.services.characteristics.values():
            self.props[ch.uuid.lower()] = list(ch.properties)
        for u in (IDENTIFY, BLOCK, STATUS, EXTCTRL):
            try:
                await self.c.start_notify(u, self.on_notify)
            except Exception as e:
                log(f"  подписка {short(u)}: {e}")

    async def write(self, uuid, data, response=None, timeout=6.0):
        if response is None:
            response = "write" in self.props.get(uuid.lower(), [])
        try:
            await asyncio.wait_for(self.c.write_gatt_char(uuid, data, response=response), timeout)
            return True
        except asyncio.TimeoutError:
            log(f"    ! timeout {len(data)}B")
            return False
        except Exception as e:
            log(f"    ! {type(e).__name__}: {e}")
            if any(s in str(e).lower() for s in ("not connected", "disconnect", "peer removed")):
                self.dropped = True
            return False

    def summarise(self, cmd):
        got = self.counts.get(self.cur)
        if not got:
            log("    (тишина)")
            return
        parts = [f"{h}{'×' + str(n) if n > 1 else ''}" for h, n in got.items()]
        log(f"    ИТОГ 0x{cmd:02X}: " + " | ".join(parts))

    # ---------- discover / probe / sweep ----------
    async def discover(self):
        log("\n[GATT] полный дамп")
        for svc in self.c.services:
            log(f"  SVC {svc.uuid}  ({svc.description})")
            for ch in svc.characteristics:
                log(f"    CHR {ch.uuid}  props={ch.properties} handle={ch.handle}")
                for d in ch.descriptors:
                    log(f"      DSC {d.uuid}")
                if "read" in ch.properties:
                    try:
                        val = await asyncio.wait_for(self.c.read_gatt_char(ch), 4.0)
                        log(f"      READ -> {bytes(val).hex(' ')}")
                    except Exception as e:
                        log(f"      READ fail: {type(e).__name__}: {e}")
        log("\n[ВЫВОД]")
        for u, p in self.props.items():
            log(f"  {short(u):6} props={p}")
        if "write" not in self.props.get(IDENTIFY.lower(), []):
            log("  !! IDENT без write — заголовок может не лечь")

    async def probe(self, codes):
        log(f"\n[ЗОНД] {len(codes)} кодов, лимит {self.args.spam_cap} на ответ")
        for cmd in codes:
            if self.dropped:
                return
            self.cur = f"0x{cmd:02X}"
            log(f"  0x{cmd:02X}")
            await self.write(EXTCTRL, bytes([cmd]))
            await asyncio.sleep(self.args.delay)
            self.summarise(cmd)
            await asyncio.sleep(self.args.delay)

    async def sweep(self):
        codes = [c for c in range(0x100) if c not in KNOWN_GOOD and c not in SILENT]
        if self.args.stop_at is not None:
            codes = [c for c in codes if c <= self.args.stop_at]
        log(f"\n[ПЕРЕБОР] {len(codes)} кодов")
        good = []
        for cmd in codes:
            if self.dropped:
                break
            self.cur = f"0x{cmd:02X}"
            log(f"  0x{cmd:02X}")
            await self.write(EXTCTRL, bytes([cmd]), timeout=3.0)
            await asyncio.sleep(self.args.delay)
            got = self.counts.get(self.cur) or {}
            if got and "ff" not in got:
                good.append(cmd)
                log("    ^ ОТВЕТ")
            await asyncio.sleep(self.args.delay)
        log("\n[НОВЫЕ КОДЫ] " + (" ".join(f"0x{c:02X}" for c in good) if good else "нет"))

    # ---------- заголовок образа ----------
    async def read_header(self):
        log("\n[ЗАГОЛОВОК] жду нотификацию на IDENT (до 6 с)")
        try:
            await asyncio.wait_for(self.hdr_seen.wait(), 6.0)
        except asyncio.TimeoutError:
            pass
        if not self.own_hdr:
            log("  не пришло. дёргаю IDENT нулями? нет — пробую read")
            if "read" in self.props.get(IDENTIFY.lower(), []):
                try:
                    v = await self.c.read_gatt_char(IDENTIFY)
                    self.own_hdr = bytes(v)[:16]
                except Exception as e:
                    log(f"  read: {e}")
        if not self.own_hdr:
            log("  ЗАГОЛОВОК НЕ ПОЛУЧЕН")
            return
        p = parse_header(self.own_hdr)
        for k, v in p.items():
            log(f"  {k:8} = {v if isinstance(v, str) else hex(v) if isinstance(v, int) else v}")
        if not p["crc_ok"]:
            log("  !! crc0/crc1 не взаимно обратны — раскладка полей может быть не стоковой")
        if p["len"] * 4 == 0:
            log("  !! len = 0, поле считается по-другому (попробуй --len-value)")

    # ---------- runtime: зелёный ----------
    async def green(self):
        combos = [(cmd, p) for cmd in GREEN_CMDS for p in GREEN_PAYLOADS]
        if self.args.only:
            idx = [i for i in self.args.only if 0 < i <= len(combos)]
            combos = [(combos[i - 1],) for i in idx]
            combos = [c[0] for c in combos]
        log(f"\n[ЗЕЛЁНЫЙ] {len(combos)} комбинаций, пауза {self.args.delay}s")
        log("  смотри на фигурку и запоминай номер, при котором загорелось")
        for i, (cmd, payload) in enumerate(combos, 1):
            if self.dropped:
                log("  связь потеряна")
                return
            self.cur = f"GREEN {i} 0x{cmd:02X}"
            log(f"  [{i}/{len(combos)}] 0x{cmd:02X} {payload.hex(' ')}")
            await self.write(EXTCTRL, bytes([cmd]) + payload)
            await asyncio.sleep(self.args.delay)
        if self.args.hold and combos:
            cmd, payload = combos[0]
            log(f"\n[HOLD] держу 0x{cmd:02X} {payload.hex(' ')} каждые 0.5 с, Ctrl-C для стопа")
            while not self.dropped:
                await self.write(EXTCTRL, bytes([cmd]) + payload, timeout=2.0)
                await asyncio.sleep(0.5)

    # ---------- прошивка ----------
    async def wait_status(self, timeout):
        try:
            return await asyncio.wait_for(self.status_q.get(), timeout)
        except asyncio.TimeoutError:
            return None

    async def oad(self, path):
        img = bytearray(open(path, "rb").read())
        if not img:
            log("пустой файл")
            return
        if len(img) % 4:
            pad = 4 - len(img) % 4
            img += b"\xff" * pad
            log(f"  добил {pad} байт до кратности 4")
        log(f"\n[OAD] образ {len(img)} байт, crc16 {crc16(bytes(img)):04X}")

        if not self.own_hdr:
            log("  нет заголовка устройства — сначала `header`")
            return
        own = parse_header(self.own_hdr)
        uid = self.args.uid_int if self.args.uid_int is not None else own["uid"] ^ 0xFFFFFFFF
        if uid == own["uid"]:
            log("  !! UID совпал с текущим — устройство отклонит")
        hdr = build_header(bytes(img), uid, template=self.own_hdr, len_value=self.args.len_value)
        log(f"  новый заголовок: {hdr.hex(' ')}")
        log(f"  uid 0x{own['uid']:08X} -> 0x{uid:08X}")
        if not self.args.force:
            await asyncio.get_event_loop().run_in_executor(None, input, "Enter для старта... ")

        if not await self.write(IDENTIFY, hdr, response=False, timeout=8.0):
            log("  заголовок не ушёл")
            return
        st = await self.wait_status(8.0)
        log(f"  статус заголовка: {OAD_STATUS.get(st, st)}")
        if st not in (0x00, None):
            log("  отказ по заголовку")
            return

        bs = self.args.block_size
        total = (len(img) + bs - 1) // bs
        log(f"  блоков {total} по {bs} B")
        t0 = time.time()
        for i in range(total):
            chunk = bytes(img[i * bs:(i + 1) * bs])
            ok = await self.write(BLOCK, struct.pack("<H", i) + chunk, response=False, timeout=6.0)
            if not ok:
                log(f"  обрыв на блоке {i}")
                return
            if i % 32 == 31 or i == total - 1:
                log(f"    {i + 1}/{total}  {100 * (i + 1) // total}%  "
                    f"{((i + 1) * bs) / max(time.time() - t0, 1e-3) / 1024:.1f} KiB/s")
            st = await self.wait_status(0.01)
            if st is not None and st != 0x00:
                log(f"  статус блока {i}: {OAD_STATUS.get(st, st)}")
                if st in (0x01, 0x02, 0x03):
                    return

        log("  все блоки отправлены, жду финальный статус")
        st = await self.wait_status(20.0)
        log(f"  финал: {OAD_STATUS.get(st, st)}")
        if st == 0x00:
            log("  УСПЕХ — фигурка уйдёт в ребут, не трогай питание 10 с")

    def report(self):
        log("\n" + "=" * 60)
        log(f"нотификаций {self.total}, подавлено {self.suppressed}, "
            f"заголовок {'есть' if self.own_hdr else 'нет'}, обрыв {'ДА' if self.dropped else 'нет'}")
        log("=" * 60)
        if self.args.dump:
            with open(self.args.dump, "w") as f:
                json.dump(self.dump, f, indent=1)
            log(f"лог: {self.args.dump}")


# ---------- оффлайн-патч образа ----------
def do_patch(path, out, pairs, rng_sel, dry):
    img = bytearray(open(path, "rb").read())
    lo, hi = rng_sel
    hits = 0
    for src, dst in pairs:
        if len(src) != len(dst):
            log(f"  пара разной длины: {src.hex()} -> {dst.hex()}, пропуск")
            continue
        start = lo
        while True:
            i = img.find(src, start, hi)
            if i < 0:
                break
            ctx = bytes(img[max(0, i - 6):i + len(src) + 6]).hex(" ")
            log(f"  0x{i:06X}: {src.hex(' ')} -> {dst.hex(' ')}   [{ctx}]")
            if not dry:
                img[i:i + len(dst)] = dst
            hits += 1
            start = i + len(dst)
    log(f"\nзамен: {hits}")
    if dry or not hits:
        return None
    c = crc16(bytes(img))
    log(f"новый crc16: {c:04X}")
    if out:
        open(out, "wb").write(img)
        log(f"записано: {out}")
    return bytes(img)


async def run(args):
    if args.mode == "patch":
        pairs = []
        for p in args.pair:
            a, b = p.split(":")
            pairs.append((bytes.fromhex(a.replace(" ", "")), bytes.fromhex(b.replace(" ", ""))))
        if not pairs:
            pairs = [(b"\xff\x00\x00", b"\x00\xff\x00")]   # red -> green (RGB)
        lo, hi = 0, 1 << 32
        if args.range:
            lo, hi = args.range
            hi += 1
        do_patch(args.file, args.out, pairs, (lo, hi), args.dry_run)
        return 0

    log(f"seed {args.seed} | режим {args.mode}")
    dev = await BleakScanner.find_device_by_filter(
        lambda d, ad: d.name and args.name.lower() in d.name.lower(), timeout=args.timeout)
    if not dev:
        log("не найдено")
        return 2
    log(f"найдено {dev.name} ({dev.address})")
    if not args.yes:
        await asyncio.get_event_loop().run_in_executor(None, input, "Enter... ")

    client = BleakClient(dev, timeout=20.0)
    await client.connect()
    m = Mario(client, args)
    try:
        await m.setup()
        if args.mode == "discover":
            await m.discover()
        elif args.mode == "probe":
            await m.probe(KNOWN_GOOD + SILENT)
        elif args.mode == "sweep":
            await m.sweep()
        elif args.mode == "header":
            await m.read_header()
        elif args.mode == "green":
            await m.green()
        elif args.mode == "oad":
            await m.read_header()
            await m.oad(args.file)
    finally:
        m.report()
        try:
            await client.disconnect()
        except Exception:
            pass
    return 0


def main():
    p = argparse.ArgumentParser()
    p.add_argument("mode", choices=["discover", "probe", "sweep", "header", "green", "patch", "oad"])
    p.add_argument("file", nargs="?", help="образ для patch/oad")
    p.add_argument("--name", default="Mario")
    p.add_argument("--timeout", type=float, default=15.0)
    p.add_argument("--delay", type=float, default=0.25)
    p.add_argument("--spam-cap", type=int, default=6)
    p.add_argument("--stop-at", type=lambda x: int(x, 0), default=None)
    p.add_argument("--seed", type=int, default=None)
    p.add_argument("--dump", default=None)
    p.add_argument("--yes", action="store_true")
    p.add_argument("--only", type=int, nargs="*", default=None)
    p.add_argument("--hold", action="store_true")
    p.add_argument("--out", default=None)
    p.add_argument("--pair", action="append", default=[])
    p.add_argument("--range", type=lambda x: int(x, 0), nargs=2, default=None)
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--block-size", type=int, default=16)
    p.add_argument("--len-value", type=lambda x: int(x, 0), default=None)
    p.add_argument("--uid-int", type=lambda x: int(x, 0), default=None)
    p.add_argument("--force", action="store_true")
    args = p.parse_args()
    if args.seed is None:
        args.seed = int(time.time()) & 0xFFFF
    if args.dump is None:
        args.dump = f"mario_{args.mode}_{int(time.time())}.json"
    if args.mode in ("patch", "oad") and not args.file:
        p.error("нужен файл образа")
    try:
        sys.exit(asyncio.run(run(args)))
    except KeyboardInterrupt:
        log("\nпрервано")


if __name__ == "__main__":
    main()
Порядок работы:

header --yes — забрать заголовок и проверить, что crc0/crc1 взаимно обратны. Если нет — раскладка полей не стоковая, и build_header надо править под неё, иначе OAD отклонит по IMG_HDR_ERR.
green --yes — перебор 120 комбинаций «команда + RGB/GRB». Зелёный должен загореться на одной из них; номер запоминаешь. green --only N --hold держит его постоянно, пока висит коннект.
Если нужен постоянный цвет, а не сессия — patch fw.bin --out green.bin --dry-run для начала, посмотреть адреса попаданий ff 00 00 (красный в RGB) и убедиться, что это таблица цветов, а не случайные данные. Потом без --dry-run, oad green.bin --yes --force.
Что важно понимать:

TI OAD только пишет — прочитать образ с фигурки нельзя. ffc1 отдаёт лишь 16-байтовый заголовок (crc, uid, версия). Сам .bin надо добывать из APK приложения LEGO или через SWD-дамп CC26xx. Без файла шаг 3 не поедет.
len в заголовке — длина/4 в один байт, для больших образов поле обрезается. Если придёт IMG_HDR_ERR, крути --len-value.
Инверсия UID обязательна: с текущим UID BIM считает образ тем же и молча ничего не делает.
Блоки по 16 байт — безопасно; можно --block-size 100 (это ровно то, что вернула команда 0x01), будет в разы быстрее, но на слабом MTU посыпется.
Заряд батареи выше 50%, фигурка не должна уходить в сон во время заливки. Если сорвалось — она останется в BIM и зальётся повторно тем же oad.
Первый OAD на «своём» образе — единственный по-настоящему рискованный шаг: заголовок не тот, и фигурка уйдёт в цикл загрузчика. Восстановление тем же инструментом, но нужен корректный стоковый образ.
Если скинешь вывод header — по crc0/crc1, len и imgType можно будет точно сказать, стоковый там OAD или LEGO его перекроил, и подгоню build_header под реальную раскладку.

#!/usr/bin/env python3

-- coding: utf-8 --
"""
mario_hack.py — LEGO Mario: перекраска в зелёный.

python3 mario_hack.py discover --yes
python3 mario_hack.py probe --yes
python3 mario_hack.py sweep --yes --stop-at 0x50
python3 mario_hack.py header --yes # снять заголовок образа с фигурки
python3 mario_hack.py green --yes # перебор команд установки цвета
python3 mario_hack.py green --yes --only 37 --hold # закрепить найденную комбинацию
python3 mario_hack.py patch fw.bin --out green.bin # red->green + пересчёт CRC
python3 mario_hack.py oad green.bin --yes --force # залить (необратимо-ish)
"""

import argparse
import asyncio
import json
import random
import struct
import sys
import time
from collections import defaultdict
from bleak import BleakScanner, BleakClient

IDENTIFY = "f000ffc1-0451-4000-b000-000000000000" # OAD image identify
BLOCK = "f000ffc2-0451-4000-b000-000000000000" # OAD image block
COUNT = "f000ffc3-0451-4000-b000-000000000000" # OAD image count
STATUS = "f000ffc4-0451-4000-b000-000000000000" # OAD status
EXTCTRL = "f000ffc5-0451-4000-b000-000000000000" # ext ctrl (команды)

NAMES = {u.lower(): n for u, n in
((IDENTIFY, "IDENT"), (BLOCK, "BLOCK"), (COUNT, "COUNT"),
(STATUS, "STATUS"), (EXTCTRL, "EXT"))}

KNOWN_GOOD = [0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x10, 0x11, 0x13]
SILENT = [0x28]

--- кандидаты для установки цвета. RGB-зелёный = 00 FF 00, GRB-зелёный = FF 00 00 ---
GREEN_CMDS = [0x10, 0x11, 0x13, 0x09, 0x06, 0x08, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F, 0x12, 0x14, 0x15]
GREEN_PAYLOADS = [
b"\x00\xff\x00", # rgb
b"\xff\x00\x00", # grb
b"\x00\x00\xff\x00", # idx + rgb
b"\x00\x00\xff\x00\xff",
b"\x01\x00\xff\x00", # idx 1 + rgb
b"\x00\xff\x00\x00\xff",
b"\x00\x00\xff",
b"\xff\x00\x00\xff",
]

OAD_STATUS = {0x00: "OK", 0x01: "CRC_ERR", 0x02: "FLASH_ERR", 0x03: "BUFFER_OFL",
0x04: "ALREADY_STARTED", 0x05: "NOT_STARTED", 0x06: "INCOMPLETE",
0x07: "BIM_CRC_ERR", 0x08: "BIM_FLASH_ERR", 0x09: "BIM_OFL",
0x0A: "TIMEOUT", 0x0C: "IMG_HDR_ERR", 0x0D: "BIM_VERIFY_ERR"}

def short(u):
return NAMES.get(u.lower(), u[:8])

def log(m=""):
print(m, flush=True)

def crc16(data):
"""CRC16-CCITT, poly 0x1021, init 0xFFFF — как в BIM."""
crc = 0xFFFF
for b in data:
crc ^= b << 8
for _ in range(8):
crc = ((crc << 1) ^ 0x1021) & 0xFFFF if crc & 0x8000 else (crc << 1) & 0xFFFF
return crc

def build_header(img, uid, template=None, ver=0x10, len_value=None):
"""16-байтовый заголовок OAD. Шаблон — собственный заголовок устройства, если есть."""
c = crc16(img)
h = bytearray(template) if template and len(template) >= 16 else bytearray(16)
h[0:2] = struct.pack("<H", c)
h[2:4] = struct.pack("<H", (~c) & 0xFFFF)
h[4] = ver
h[5] = (len_value if len_value is not None else (len(img) // 4)) & 0xFF
h[6:8] = b"\xff\xff"
h[8:12] = struct.pack("<I", uid & 0xFFFFFFFF)
h[12:14] = b"\x00\x00"
h[14] = 0x01 # imgVld
h[15] = 0x01 # imgType = app
return bytes(h)

def parse_header(h):
c0, c1, ver, ln, rfu, uid, addr, vld, typ = struct.unpack("<HHBBHIHBB", h[:16])
return dict(crc0=c0, crc1=c1, crc_ok=(c1 == (~c0) & 0xFFFF), ver=ver, len=ln,
rfu=rfu, uid=uid, addr=addr, vld=vld, typ=typ)

class Mario:
def init(self, client, args):
self.c = client
self.args = args
self.rng = random.Random(args.seed)
self.props = {}
self.dump = {"ts": time.time(), "events": []}
self.own_hdr = None
self.cur = "idle"
self.counts = defaultdict(lambda: defaultdict(int))
self.total = 0
self.suppressed = 0
self.dropped = False
self.hdr_seen = asyncio.Event()
self.status_q = asyncio.Queue()

# ---------- транспорт ----------
def on_notify(self, sender, data):
    raw = bytes(data)
    name = short(sender.uuid)
    h = raw.hex(" ")
    self.total += 1
    self.dump["events"].append({"t": time.time(), "cmd": self.cur, "ch": name, "data": h})

    n = self.counts[self.cur][h]
    self.counts[self.cur][h] = n + 1
    if n < self.args.spam_cap:
        log(f"    [{name}] {h}")
    elif n == self.args.spam_cap:
        log(f"    [{name}] {h} ...дальше подавляю")
        self.suppressed += 1
    else:
        self.suppressed += 1

    if sender.uuid.lower() == STATUS.lower() and raw:
        self.status_q.put_nowait(raw[0])
    if sender.uuid.lower() == IDENTIFY.lower() and self.own_hdr is None and len(raw) >= 16:
        self.own_hdr = raw[:16]
        self.hdr_seen.set()
        log(f"    >>> ЗАГОЛОВОК УСТРОЙСТВА: {raw[:16].hex(' ')}")

async def setup(self):
    for ch in self.c.services.characteristics.values():
        self.props[ch.uuid.lower()] = list(ch.properties)
    for u in (IDENTIFY, BLOCK, STATUS, EXTCTRL):
        try:
            await self.c.start_notify(u, self.on_notify)
        except Exception as e:
            log(f"  подписка {short(u)}: {e}")

async def write(self, uuid, data, response=None, timeout=6.0):
    if response is None:
        response = "write" in self.props.get(uuid.lower(), [])
    try:
        await asyncio.wait_for(self.c.write_gatt_char(uuid, data, response=response), timeout)
        return True
    except asyncio.TimeoutError:
        log(f"    ! timeout {len(data)}B")
        return False
    except Exception as e:
        log(f"    ! {type(e).__name__}: {e}")
        if any(s in str(e).lower() for s in ("not connected", "disconnect", "peer removed")):
            self.dropped = True
        return False

def summarise(self, cmd):
    got = self.counts.get(self.cur)
    if not got:
        log("    (тишина)")
        return
    parts = [f"{h}{'×' + str(n) if n > 1 else ''}" for h, n in got.items()]
    log(f"    ИТОГ 0x{cmd:02X}: " + " | ".join(parts))

# ---------- discover / probe / sweep ----------
async def discover(self):
    log("\n[GATT] полный дамп")
    for svc in self.c.services:
        log(f"  SVC {svc.uuid}  ({svc.description})")
        for ch in svc.characteristics:
            log(f"    CHR {ch.uuid}  props={ch.properties} handle={ch.handle}")
            for d in ch.descriptors:
                log(f"      DSC {d.uuid}")
            if "read" in ch.properties:
                try:
                    val = await asyncio.wait_for(self.c.read_gatt_char(ch), 4.0)
                    log(f"      READ -> {bytes(val).hex(' ')}")
                except Exception as e:
                    log(f"      READ fail: {type(e).__name__}: {e}")
    log("\n[ВЫВОД]")
    for u, p in self.props.items():
        log(f"  {short(u):6} props={p}")
    if "write" not in self.props.get(IDENTIFY.lower(), []):
        log("  !! IDENT без write — заголовок может не лечь")

async def probe(self, codes):
    log(f"\n[ЗОНД] {len(codes)} кодов, лимит {self.args.spam_cap} на ответ")
    for cmd in codes:
        if self.dropped:
            return
        self.cur = f"0x{cmd:02X}"
        log(f"  0x{cmd:02X}")
        await self.write(EXTCTRL, bytes([cmd]))
        await asyncio.sleep(self.args.delay)
        self.summarise(cmd)
        await asyncio.sleep(self.args.delay)

async def sweep(self):
    codes = [c for c in range(0x100) if c not in KNOWN_GOOD and c not in SILENT]
    if self.args.stop_at is not None:
        codes = [c for c in codes if c <= self.args.stop_at]
    log(f"\n[ПЕРЕБОР] {len(codes)} кодов")
    good = []
    for cmd in codes:
        if self.dropped:
            break
        self.cur = f"0x{cmd:02X}"
        log(f"  0x{cmd:02X}")
        await self.write(EXTCTRL, bytes([cmd]), timeout=3.0)
        await asyncio.sleep(self.args.delay)
        got = self.counts.get(self.cur) or {}
        if got and "ff" not in got:
            good.append(cmd)
            log("    ^ ОТВЕТ")
        await asyncio.sleep(self.args.delay)
    log("\n[НОВЫЕ КОДЫ] " + (" ".join(f"0x{c:02X}" for c in good) if good else "нет"))

# ---------- заголовок образа ----------
async def read_header(self):
    log("\n[ЗАГОЛОВОК] жду нотификацию на IDENT (до 6 с)")
    try:
        await asyncio.wait_for(self.hdr_seen.wait(), 6.0)
    except asyncio.TimeoutError:
        pass
    if not self.own_hdr:
        log("  не пришло. дёргаю IDENT нулями? нет — пробую read")
        if "read" in self.props.get(IDENTIFY.lower(), []):
            try:
                v = await self.c.read_gatt_char(IDENTIFY)
                self.own_hdr = bytes(v)[:16]
            except Exception as e:
                log(f"  read: {e}")
    if not self.own_hdr:
        log("  ЗАГОЛОВОК НЕ ПОЛУЧЕН")
        return
    p = parse_header(self.own_hdr)
    for k, v in p.items():
        log(f"  {k:8} = {v if isinstance(v, str) else hex(v) if isinstance(v, int) else v}")
    if not p["crc_ok"]:
        log("  !! crc0/crc1 не взаимно обратны — раскладка полей может быть не стоковой")
    if p["len"] * 4 == 0:
        log("  !! len = 0, поле считается по-другому (попробуй --len-value)")

# ---------- runtime: зелёный ----------
async def green(self):
    combos = [(cmd, p) for cmd in GREEN_CMDS for p in GREEN_PAYLOADS]
    if self.args.only:
        idx = [i for i in self.args.only if 0 < i <= len(combos)]
        combos = [(combos[i - 1],) for i in idx]
        combos = [c[0] for c in combos]
    log(f"\n[ЗЕЛЁНЫЙ] {len(combos)} комбинаций, пауза {self.args.delay}s")
    log("  смотри на фигурку и запоминай номер, при котором загорелось")
    for i, (cmd, payload) in enumerate(combos, 1):
        if self.dropped:
            log("  связь потеряна")
            return
        self.cur = f"GREEN {i} 0x{cmd:02X}"
        log(f"  [{i}/{len(combos)}] 0x{cmd:02X} {payload.hex(' ')}")
        await self.write(EXTCTRL, bytes([cmd]) + payload)
        await asyncio.sleep(self.args.delay)
    if self.args.hold and combos:
        cmd, payload = combos[0]
        log(f"\n[HOLD] держу 0x{cmd:02X} {payload.hex(' ')} каждые 0.5 с, Ctrl-C для стопа")
        while not self.dropped:
            await self.write(EXTCTRL, bytes([cmd]) + payload, timeout=2.0)
            await asyncio.sleep(0.5)

# ---------- прошивка ----------
async def wait_status(self, timeout):
    try:
        return await asyncio.wait_for(self.status_q.get(), timeout)
    except asyncio.TimeoutError:
        return None

async def oad(self, path):
    img = bytearray(open(path, "rb").read())
    if not img:
        log("пустой файл")
        return
    if len(img) % 4:
        pad = 4 - len(img) % 4
        img += b"\xff" * pad
        log(f"  добил {pad} байт до кратности 4")
    log(f"\n[OAD] образ {len(img)} байт, crc16 {crc16(bytes(img)):04X}")

    if not self.own_hdr:
        log("  нет заголовка устройства — сначала `header`")
        return
    own = parse_header(self.own_hdr)
    uid = self.args.uid_int if self.args.uid_int is not None else own["uid"] ^ 0xFFFFFFFF
    if uid == own["uid"]:
        log("  !! UID совпал с текущим — устройство отклонит")
    hdr = build_header(bytes(img), uid, template=self.own_hdr, len_value=self.args.len_value)
    log(f"  новый заголовок: {hdr.hex(' ')}")
    log(f"  uid 0x{own['uid']:08X} -> 0x{uid:08X}")
    if not self.args.force:
        await asyncio.get_event_loop().run_in_executor(None, input, "Enter для старта... ")

    if not await self.write(IDENTIFY, hdr, response=False, timeout=8.0):
        log("  заголовок не ушёл")
        return
    st = await self.wait_status(8.0)
    log(f"  статус заголовка: {OAD_STATUS.get(st, st)}")
    if st not in (0x00, None):
        log("  отказ по заголовку")
        return

    bs = self.args.block_size
    total = (len(img) + bs - 1) // bs
    log(f"  блоков {total} по {bs} B")
    t0 = time.time()
    for i in range(total):
        chunk = bytes(img[i * bs:(i + 1) * bs])
        ok = await self.write(BLOCK, struct.pack("<H", i) + chunk, response=False, timeout=6.0)
        if not ok:
            log(f"  обрыв на блоке {i}")
            return
        if i % 32 == 31 or i == total - 1:
            log(f"    {i + 1}/{total}  {100 * (i + 1) // total}%  "
                f"{((i + 1) * bs) / max(time.time() - t0, 1e-3) / 1024:.1f} KiB/s")
        st = await self.wait_status(0.01)
        if st is not None and st != 0x00:
            log(f"  статус блока {i}: {OAD_STATUS.get(st, st)}")
            if st in (0x01, 0x02, 0x03):
                return

    log("  все блоки отправлены, жду финальный статус")
    st = await self.wait_status(20.0)
    log(f"  финал: {OAD_STATUS.get(st, st)}")
    if st == 0x00:
        log("  УСПЕХ — фигурка уйдёт в ребут, не трогай питание 10 с")

def report(self):
    log("\n" + "=" * 60)
    log(f"нотификаций {self.total}, подавлено {self.suppressed}, "
        f"заголовок {'есть' if self.own_hdr else 'нет'}, обрыв {'ДА' if self.dropped else 'нет'}")
    log("=" * 60)
    if self.args.dump:
        with open(self.args.dump, "w") as f:
            json.dump(self.dump, f, indent=1)
        log(f"лог: {self.args.dump}")
---------- оффлайн-патч образа ----------
def do_patch(path, out, pairs, rng_sel, dry):
img = bytearray(open(path, "rb").read())
lo, hi = rng_sel
hits = 0
for src, dst in pairs:
if len(src) != len(dst):
log(f" пара разной длины: {src.hex()} -> {dst.hex()}, пропуск")
continue
start = lo
while True:
i = img.find(src, start, hi)
if i < 0:
break
ctx = bytes(img[max(0, i - 6):i + len(src) + 6]).hex(" ")
log(f" 0x{i:06X}: {src.hex(' ')} -> {dst.hex(' ')} [{ctx}]")
if not dry:
img[i:i + len(dst)] = dst
hits += 1
start = i + len(dst)
log(f"\nзамен: {hits}")
if dry or not hits:
return None
c = crc16(bytes(img))
log(f"новый crc16: {c:04X}")
if out:
open(out, "wb").write(img)
log(f"записано: {out}")
return bytes(img)

async def run(args):
if args.mode == "patch":
pairs = []
for p in args.pair:
a, b = p.split(":")
pairs.append((bytes.fromhex(a.replace(" ", "")), bytes.fromhex(b.replace(" ", ""))))
if not pairs:
pairs = [(b"\xff\x00\x00", b"\x00\xff\x00")] # red -> green (RGB)
lo, hi = 0, 1 << 32
if args.range:
lo, hi = args.range
hi += 1
do_patch(args.file, args.out, pairs, (lo, hi), args.dry_run)
return 0

log(f"seed {args.seed} | режим {args.mode}")
dev = await BleakScanner.find_device_by_filter(
    lambda d, ad: d.name and args.name.lower() in d.name.lower(), timeout=args.timeout)
if not dev:
    log("не найдено")
    return 2
log(f"найдено {dev.name} ({dev.address})")
if not args.yes:
    await asyncio.get_event_loop().run_in_executor(None, input, "Enter... ")

client = BleakClient(dev, timeout=20.0)
await client.connect()
m = Mario(client, args)
try:
    await m.setup()
    if args.mode == "discover":
        await m.discover()
    elif args.mode == "probe":
        await m.probe(KNOWN_GOOD + SILENT)
    elif args.mode == "sweep":
        await m.sweep()
    elif args.mode == "header":
        await m.read_header()
    elif args.mode == "green":
        await m.green()
    elif args.mode == "oad":
        await m.read_header()
        await m.oad(args.file)
finally:
    m.report()
    try:
        await client.disconnect()
    except Exception:
        pass
return 0
def main():
p = argparse.ArgumentParser()
p.add_argument("mode", choices=["discover", "probe", "sweep", "header", "green", "patch", "oad"])
p.add_argument("file", nargs="?", help="образ для patch/oad")
p.add_argument("--name", default="Mario")
p.add_argument("--timeout", type=float, default=15.0)
p.add_argument("--delay", type=float, default=0.25)
p.add_argument("--spam-cap", type=int, default=6)
p.add_argument("--stop-at", type=lambda x: int(x, 0), default=None)
p.add_argument("--seed", type=int, default=None)
p.add_argument("--dump", default=None)
p.add_argument("--yes", action="store_true")
p.add_argument("--only", type=int, nargs="*", default=None)
p.add_argument("--hold", action="store_true")
p.add_argument("--out", default=None)
p.add_argument("--pair", action="append", default=[])
p.add_argument("--range", type=lambda x: int(x, 0), nargs=2, default=None)
p.add_argument("--dry-run", action="store_true")
p.add_argument("--block-size", type=int, default=16)
p.add_argument("--len-value", type=lambda x: int(x, 0), default=None)
p.add_argument("--uid-int", type=lambda x: int(x, 0), default=None)
p.add_argument("--force", action="store_true")
args = p.parse_args()
if args.seed is None:
args.seed = int(time.time()) & 0xFFFF
if args.dump is None:
args.dump = f"mario_{args.mode}_{int(time.time())}.json"
if args.mode in ("patch", "oad") and not args.file:
