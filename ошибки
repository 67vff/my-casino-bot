    // ================== СООБЩЕНИЯ С ОГРАНИЧЕНИЕМ СПАМА ==================

    private void sendRateLimited(Player player, Component message) {
        long now = System.currentTimeMillis();
        Long last = lastMessageTime.get(player.getUniqueId());
        if (last != null && now - last < cfgInt("messages.rate-limit-ms", 1000)) return;
        lastMessageTime.put(player.getUniqueId(), now);
        player.sendMessage(message);
    }

    // ================== КОМАНДЫ ВЫДАЧИ ==================

    private void giveItem(Player target, ItemStack item, String itemName, CommandSender sender) {
        Map<Integer, ItemStack> overflow = target.getInventory().addItem(item);
        for (ItemStack drop : overflow.values()) {
            target.getWorld().dropItemNaturally(target.getLocation(), drop);
        }
        if (!itemName.isEmpty()) {
            target.sendMessage(Component.text("Вы получили: " + itemName, NamedTextColor.GREEN));
            if (!target.equals(sender)) {
                sender.sendMessage(Component.text("Предмет «" + itemName + "» выдан игроку " + target.getName(), NamedTextColor.GREEN));
            }
        }
    }

    @Override
    public boolean onCommand(@NotNull CommandSender sender, @NotNull Command command, @NotNull String label, @NotNull String[] args) {
        String cmd = command.getName().toLowerCase();

        Player target = null;
        if (args.length == 0 && sender instanceof Player player) {
            target = player;
        } else if (args.length == 1) {
            target = Bukkit.getPlayer(args[0]);
        }
        if (target == null) {
            sender.sendMessage(Component.text("Игрок не найден или укажите ник: /" + cmd + " [ник]", NamedTextColor.RED));
            return true;
        }

        if (cmd.equals("trapkaall")) {
            List<ItemStack> allItems = List.of(
                    createTrapkaItem(), createMinerTrapItem(), createPlatformItem(),
                    createMinerPickaxe(1), createMinerPickaxe(2),
                    createTntMiner(1), createTntMiner(2), createTntMiner(3),
                    createUnderwaterTntItem(),
                    createHeadMiner(), createMightyForceItem(),
                    createShulkerItem(),
                    createMinerCart(1), createMinerCart(2), createMinerCart(3),
                    tntItems.getItem("tnt5"), tntItems.getItem("tnt5o"),
                    tntItems.getItem("tnt5w"), tntItems.getItem("tnt5ow"),
                    tntItems.getItem("tnt10"), tntItems.getItem("tnt10o"),
                    tntItems.getItem("tnt10w"), tntItems.getItem("tnt10ow")
            );
            for (ItemStack it : allItems) {
                if (it != null) giveItem(target, it, "", sender);
            }
            target.sendMessage(Component.text("Вы получили полный набор всех предметов плагина!", NamedTextColor.GREEN));
            if (!target.equals(sender)) {
                sender.sendMessage(Component.text("Полный набор выдан игроку " + target.getName(), NamedTextColor.GREEN));
            }
            return true;
        }

        ItemStack item;
        String name;
        switch (cmd) {
            case "trapka" -> { item = createTrapkaItem(); name = "Трапка"; }
            case "minertrap" -> { item = createMinerTrapItem(); name = "Трапка Шахтёра"; }
            case "platform" -> { item = createPlatformItem(); name = "Платформа"; }
            case "miner1" -> { item = createMinerPickaxe(1); name = "Кирка Шахтёра I"; }
            case "miner2" -> { item = createMinerPickaxe(2); name = "Кирка Шахтёра II"; }
            case "tnt1" -> { item = createTntMiner(1); name = "ТНТ Стилер 1"; }
            case "tnt2" -> { item = createTntMiner(2); name = "ТНТ Стилер 2"; }
            case "tnt3" -> { item = createTntMiner(3); name = "ТНТ Стилер 3"; }
            case "utnt" -> { item = createUnderwaterTntItem(); name = "Подводная ТНТ"; }
            case "headminer" -> { item = createHeadMiner(); name = "Голова Шахтёра"; }
            case "mightyforce" -> { item = createMightyForceItem(); name = "Могучая сила"; }
            case "shulker" -> { item = createShulkerItem(); name = "Шалкер"; }
            case "cart" -> { item = createMinerCart(3); name = "Вагонетка Шахтёра с ТНТ"; }
            case "tnt5" -> { item = tntItems.getItem("tnt5"); name = "Мощная ТНТ"; }
            case "tnt5o" -> { item = tntItems.getItem("tnt5o"); name = "Мощная ТНТ Обсидиана"; }
            case "tnt5w" -> { item = tntItems.getItem("tnt5w"); name = "Подводная Мощная ТНТ"; }
            case "tnt5ow" -> { item = tntItems.getItem("tnt5ow"); name = "Подводная Мощная ТНТ Обсидиана"; }
            case "tnt10" -> { item = tntItems.getItem("tnt10"); name = "Тяжёлая ТНТ"; }
            case "tnt10o" -> { item = tntItems.getItem("tnt10o"); name = "Тяжёлая ТНТ Обсидиана"; }
            case "tnt10w" -> { item = tntItems.getItem("tnt10w"); name = "Подводная Тяжёлая ТНТ"; }
            case "tnt10ow" -> { item = tntItems.getItem("tnt10ow"); name = "Подводная Тяжёлая ТНТ Обсидиана"; }
            default -> { return false; }
        }

        giveItem(target, item, name, sender);
        return true;
    }

