    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onTntPrime(TNTPrimeEvent event) {
        Location loc = event.getBlock().getLocation();

        if (placedUnderwaterTnts.remove(loc)) {
            event.setCancelled(true);
            event.getBlock().setType(Material.AIR);
            TNTPrimed tnt = loc.getWorld().spawn(loc.clone().add(0.5, 0.0, 0.5), TNTPrimed.class);
            tnt.setFuseTicks(cfgInt("utnt.fuse-seconds", 4) * 20);
            tnt.getPersistentDataContainer().set(underwaterTntKey, PersistentDataType.BYTE, (byte) 1);
            startFuseTimer(tnt, tnt::getFuseTicks);
            loc.getWorld().playSound(loc, Sound.ENTITY_TNT_PRIMED, 1.0f, 0.8f);
            return;
        }

        Integer lvl = placedMinerTnts.remove(loc);
        if (lvl != null && lvl > 0) {
            event.setCancelled(true);
            event.getBlock().setType(Material.AIR);
            TNTPrimed tnt = loc.getWorld().spawn(loc.clone().add(0.5, 0.0, 0.5), TNTPrimed.class);
            tnt.setFuseTicks(cfgInt("miner-tnt.fuse-seconds", 4) * 20);
            tnt.getPersistentDataContainer().set(tntMinerKey, PersistentDataType.INTEGER, lvl);
            startFuseTimer(tnt, tnt::getFuseTicks);
            loc.getWorld().playSound(loc, Sound.ENTITY_TNT_PRIMED, 1.0f, 1.0f);
        }
    }

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onFlintAndSteelUse(PlayerInteractEvent event) {
        if (event.getAction() != Action.RIGHT_CLICK_BLOCK) return;
        ItemStack hand = event.getItem();
        if (hand == null) return;
        Material handType = hand.getType();
        if (handType != Material.FLINT_AND_STEEL && handType != Material.FIRE_CHARGE) return;

        Block clicked = event.getClickedBlock();
        if (clicked == null) return;
        Location loc = clicked.getLocation();

        boolean isU = placedUnderwaterTnts.contains(loc);
        Integer minerLvl = placedMinerTnts.get(loc);
        if (!isU && minerLvl == null) return;

        event.setCancelled(true);
        clicked.setType(Material.AIR, false);
        placedUnderwaterTnts.remove(loc);
        placedMinerTnts.remove(loc);

        TNTPrimed tnt = loc.getWorld().spawn(loc.clone().add(0.5, 0.0, 0.5), TNTPrimed.class);
        if (isU) {
            tnt.setFuseTicks(cfgInt("utnt.fuse-seconds", 4) * 20);
            tnt.getPersistentDataContainer().set(underwaterTntKey, PersistentDataType.BYTE, (byte) 1);
        } else {
            tnt.setFuseTicks(cfgInt("miner-tnt.fuse-seconds", 4) * 20);
            tnt.getPersistentDataContainer().set(tntMinerKey, PersistentDataType.INTEGER, minerLvl);
        }
        startFuseTimer(tnt, tnt::getFuseTicks);
        loc.getWorld().playSound(loc, Sound.ENTITY_TNT_PRIMED, 1.0f, 1.0f);

        if (handType == Material.FLINT_AND_STEEL
                && event.getPlayer().getGameMode() != GameMode.CREATIVE
                && hand.getItemMeta() instanceof Damageable dmg) {
            dmg.setDamage(dmg.getDamage() + 1);
            hand.setItemMeta(dmg);
        }
    }

    // ================== ТАЙМЕР ДО ВЗРЫВА (крупный, едет вместе с ТНТ) ==================

    private void startFuseTimer(Entity entity, IntSupplier fuseTicks) {
        TextDisplay display = entity.getWorld().spawn(
                entity.getLocation().add(0, 1.6, 0), TextDisplay.class, d -> {
                    d.setText(String.valueOf((int) Math.ceil(fuseTicks.getAsInt() / 20.0)));
                    d.setBillboard(Display.Billboard.CENTER);
                    d.setSeeThrough(true);
                    d.setPersistent(false);
                    d.setTransformation(new Transformation(
                            new Vector3f(0, 0, 0), new AxisAngle4f(),
                            new Vector3f(3f, 3f, 3f), new AxisAngle4f()));
                });

        new BukkitRunnable() {
            @Override
            public void run() {
                if (!entity.isValid() || entity.isDead()) {
                    if (display.isValid()) display.remove();
                    cancel();
                    return;
                }
                display.teleport(entity.getLocation().add(0, 1.6, 0));
                int remain = (int) Math.ceil(fuseTicks.getAsInt() / 20.0);
                display.setText(String.valueOf(Math.max(remain, 0)));
            }
        }.runTaskTimer(this, 0L, 1L);
    }

