    // ================== ЗАПРЕТ ПРИЗЫВА СУЩНОСТЕЙ В ТРАПКАХ ==================

    private boolean isInsideAnyTrap(Location loc) {
        Location blockLoc = loc.getBlock().getLocation();
        if (trapkaZones.contains(blockLoc)) return true;
        return minerTrapZones.contains(blockLoc) || minerTrapZones.contains(blockLoc.clone().add(0, 1, 0));
    }

    private boolean isSummonItem(Material m) {
        String n = m.name();
        return n.endsWith("_SPAWN_EGG")
                || n.equals("ARMOR_STAND")
                || n.equals("END_CRYSTAL")
                || n.endsWith("_MINECART")
                || n.endsWith("_BOAT") || n.endsWith("_RAFT")
                || n.equals("ITEM_FRAME") || n.equals("GLOW_ITEM_FRAME");
    }

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onSummonInsideTrap(PlayerInteractEvent event) {
        if (event.getAction() != Action.RIGHT_CLICK_BLOCK
                && event.getAction() != Action.RIGHT_CLICK_AIR) return;
        ItemStack item = event.getItem();
        if (item == null || !isSummonItem(item.getType())) return;

        if (isInsideAnyTrap(event.getPlayer().getLocation())) {
            event.setCancelled(true);
            event.setUseItemInHand(Event.Result.DENY);
            event.setUseInteractedBlock(Event.Result.DENY);
            sendRateLimited(event.getPlayer(), line("Внутри трапки нельзя ничего призывать!"));
        }
    }

    // ================== УСТАНОВКА БЛОКОВ ==================

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onBlockPlace(BlockPlaceEvent event) {
        ItemStack hand = event.getItemInHand();
        if (isPlatform(hand) || isHeadMiner(hand) || isMinerTrap(hand)
                || isMightyForce(hand) || isTrapka(hand) || isShulkerItem(hand) || isMinerCart(hand)) {
            event.setCancelled(true);
            return;
        }

        Block target = event.getBlockPlaced();
        Location placedLoc = target.getLocation();

        if (protectedBlocks.contains(placedLoc)
                || noBuildZones.contains(placedLoc)
                || trapkaZones.contains(placedLoc)
                || minerTrapZones.contains(placedLoc)) {
            event.setCancelled(true);
            sendRateLimited(event.getPlayer(), line("Внутри трапки нельзя ставить блоки!"));
            return;
        }

        if (isUnderwaterTnt(hand)) {
            if (isLiquidMaterial(target.getType())) {
                event.setCancelled(true);
                if (event.getPlayer().getGameMode() != GameMode.CREATIVE) {
                    hand.setAmount(hand.getAmount() - 1);
                }
                TNTPrimed tnt = target.getWorld().spawn(
                        target.getLocation().add(0.5, 0.1, 0.5), TNTPrimed.class);
                tnt.setFuseTicks(cfgInt("utnt.fuse-seconds", 4) * 20);
                tnt.getPersistentDataContainer().set(underwaterTntKey, PersistentDataType.BYTE, (byte) 1);
                startFuseTimer(tnt, tnt::getFuseTicks);
                target.getWorld().playSound(target.getLocation(), Sound.ENTITY_TNT_PRIMED, 1.0f, 0.8f);
            } else {
                placedUnderwaterTnts.add(placedLoc);
            }
            return;
        }

        int tntLvl = getTntMinerLevel(hand);
        if (tntLvl > 0) {
            if (isLiquidMaterial(target.getType())) {
                event.setCancelled(true);
                if (event.getPlayer().getGameMode() != GameMode.CREATIVE) {
                    hand.setAmount(hand.getAmount() - 1);
                }
                TNTPrimed tnt = target.getWorld().spawn(
                        target.getLocation().add(0.5, 0.1, 0.5), TNTPrimed.class);
                tnt.setFuseTicks(cfgInt("miner-tnt.fuse-seconds", 4) * 20);
                tnt.getPersistentDataContainer().set(tntMinerKey, PersistentDataType.INTEGER, tntLvl);
                startFuseTimer(tnt, tnt::getFuseTicks);
                target.getWorld().playSound(target.getLocation(), Sound.ENTITY_TNT_PRIMED, 1.0f, 1.0f);
            } else {
                placedMinerTnts.put(placedLoc, tntLvl);
            }
            return;
        }

        if (target.getType() == Material.SPAWNER && hand.hasItemMeta()) {
            String mobName = hand.getItemMeta().getPersistentDataContainer().get(spawnerMobKey, PersistentDataType.STRING);
            if (mobName != null && !mobName.isEmpty()) {
                try {
                    EntityType type = EntityType.valueOf(mobName);
                    if (target.getState() instanceof CreatureSpawner spawner) {
                        spawner.setSpawnedType(type);
                        spawner.update();
                    }
                } catch (IllegalArgumentException ignored) {
                }
            }
        }
    }

