    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onEntityExplode(EntityExplodeEvent event) {
        if (!event.blockList().isEmpty()) {
            event.blockList().removeIf(b ->
                    protectedBlocks.contains(b.getLocation())
                            || noBuildZones.contains(b.getLocation()));
        }

        if (event.getEntity() instanceof ExplosiveMinecart mc) {
            Integer cartLvl = mc.getPersistentDataContainer().get(tntMinerKey, PersistentDataType.INTEGER);
            if (cartLvl != null && cartLvl > 0) {
                event.blockList().clear();
                destroyNearestSpawner(mc.getLocation(), cartLvl);
            }
            return;
        }

        if (!(event.getEntity() instanceof TNTPrimed tnt)) return;
        PersistentDataContainer pdc = tnt.getPersistentDataContainer();

        if (pdc.has(underwaterTntKey, PersistentDataType.BYTE)) {
            handleUnderwaterExplosion(event, tnt);
            return;
        }

        Integer tntLvl = pdc.get(tntMinerKey, PersistentDataType.INTEGER);
        if (tntLvl == null || tntLvl <= 0) return;

        event.blockList().clear();
        destroyNearestSpawner(tnt.getLocation(), tntLvl);
    }

    private void destroyNearestSpawner(Location center, int level) {
        int radius = cfgInt("miner-tnt.search-radius", 15);
        Block closestSpawner = null;
        double minDistSq = Double.MAX_VALUE;

        for (int x = -radius; x <= radius; x++) {
            for (int y = -radius; y <= radius; y++) {
                for (int z = -radius; z <= radius; z++) {
                    Block b = center.getBlock().getRelative(x, y, z);
                    if (b.getType() == Material.SPAWNER && !protectedBlocks.contains(b.getLocation())) {
                        double distSq = b.getLocation().add(0.5, 0.5, 0.5).distanceSquared(center);
                        if (distSq <= (double) radius * radius && distSq < minDistSq) {
                            minDistSq = distSq;
                            closestSpawner = b;
                        }
                    }
                }
            }
        }

        if (closestSpawner == null) return;

        EntityType spawnedType = null;
        if (closestSpawner.getState() instanceof CreatureSpawner cs) {
            spawnedType = cs.getSpawnedType();
        }

        closestSpawner.setType(Material.AIR);

        int chance = stilerChance(level);
        int roll = ThreadLocalRandom.current().nextInt(100);
        if (roll < chance) {
            ItemStack spawnerItem = createSpawnerItemWithMob(spawnedType);
            closestSpawner.getWorld().dropItemNaturally(closestSpawner.getLocation().add(0.5, 0.5, 0.5), spawnerItem);
            closestSpawner.getWorld().playSound(closestSpawner.getLocation(), Sound.ENTITY_PLAYER_LEVELUP, 1.0f, 1.5f);
        } else {
            closestSpawner.getWorld().playSound(closestSpawner.getLocation(), Sound.BLOCK_ANVIL_DESTROY, 1.0f, 1.0f);
        }
    }

    private void handleUnderwaterExplosion(EntityExplodeEvent event, TNTPrimed tnt) {
        Location center = tnt.getLocation();
        World world = center.getWorld();
        if (world == null) return;

        int radius = cfgInt("utnt.explosion-radius", 4);
        int cx = center.getBlockX();
        int cy = center.getBlockY();
        int cz = center.getBlockZ();

        List<Location> broken = new ArrayList<>();

        for (int dx = -radius; dx <= radius; dx++) {
            for (int dy = -radius; dy <= radius; dy++) {
                for (int dz = -radius; dz <= radius; dz++) {
                    if ((double) dx * dx + (double) dy * dy + (double) dz * dz > (double) radius * radius) continue;
                    Block b = world.getBlockAt(cx + dx, cy + dy, cz + dz);
                    Material m = b.getType();
                    if (m.isAir() || isLiquidMaterial(m)) continue;
                    if (isUntouchable(m)) continue;
                    if (protectedBlocks.contains(b.getLocation())) continue;
                    event.blockList().add(b);
                    broken.add(b.getLocation());
                }
            }
        }

        world.playSound(center, Sound.ENTITY_GENERIC_EXPLODE, 2.0f, 0.8f);

        // Вода восстанавливается моментально — на следующий тик
        if (!broken.isEmpty()) {
            List<BlockFace> faces = List.of(BlockFace.UP, BlockFace.DOWN,
                    BlockFace.NORTH, BlockFace.SOUTH, BlockFace.EAST, BlockFace.WEST);
            Bukkit.getScheduler().runTaskLater(this, () -> {
                for (Location l : broken) {
                    Block b = l.getBlock();
                    if (!b.getType().isAir()) continue;
                    for (BlockFace f : faces) {
                        Material n = b.getRelative(f).getType();
                        if (n == Material.WATER || n == Material.BUBBLE_COLUMN) {
                            b.setType(Material.WATER, false);
                            break;
                        }
                    }
                }
            }, 1L);
        }
    }

