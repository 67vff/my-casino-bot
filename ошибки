    @EventHandler
    public void onCraft(PrepareItemCraftEvent event) {
        if (event.getRecipe() != null && isMinerCart(event.getRecipe().getResult())) return;

        for (ItemStack item : event.getInventory().getMatrix()) {
            if (item == null) continue;
            if (isTrapka(item) || isMinerTrap(item) || isPlatform(item) || getMinerLevel(item) > 0
                    || getTntMinerLevel(item) > 0 || isUnderwaterTnt(item)
                    || isHeadMiner(item) || isMightyForce(item) || isShulkerItem(item)
                    || isMinerCart(item)) {
                event.getInventory().setResult(null);
                break;
            }
        }
    }

