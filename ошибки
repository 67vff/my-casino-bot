import argparse
import asyncio
import json
import struct
import sys
import time
from collections import defaultdict
from bleak import BleakScanner, BleakClient

IDENTIFY = "f000ffc1-0451-4000-b000-000000000000"
BLOCK    = "f000ffc2-0451-4000-b000-000000000000"
COUNT    = "f000ffc3-0451-4000-b000-000000000000"
STATUS   = "f000ffc4-0451-4000-b000-000000000000"
EXTCTRL  = "f000ffc5-0451-4000-b000-000000000000"

NAMES = {u.lower(): n for u, n in
         ((IDENTIFY, "IDENT"), (BLOCK, "BLOCK"), (COUNT, "COUNT"),
          (STATUS, "STATUS"), (EXTCTRL, "EXT"))}

KNOWN_GOOD = [0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x10, 0x11, 0x13]
SILENT = [0x28]

GREEN_CMDS = [0x10, 0x11, 0x13, 0x09, 0x06, 0x08, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F, 0x12, 0x14, 0x15]
GREEN_PAYLOADS = [
    b"\x00\xff\x00", b"\xff\x00\x00", b"\x00\x00\xff\x00", b"\x00\x00\xff\x00\xff",
    b"\x01\x00\xff\x00", b"\x00\xff\x00\x00\xff", b"\x00\x00\xff", b"\xff\x00\x00\xff",
]

OAD_STATUS = {0x00: "OK", 0x01: "CRC_ERR", 0x02: "FLASH_ERR", 0x03: "BUFFER_OFL",
              0x04: "ALREADY_STARTED", 0x05: "NOT_STARTED", 0x06: "INCOMPLETE",
              0x07: "BIM_CRC_ERR", 0x08: "BIM_FLASH_ERR", 0x09: "BIM_OFL",
              0x0A: "TIMEOUT", 0x0C: "IMG_HDR_ERR", 0x0D: "BIM_VERIFY_ERR"}


def short(u):
    return NAMES.get(u.lower(), u[:8])


def log(m=""):
    print(m, flush=True)


def crc16(data):
    crc = 0xFFFF
    for b in data:
        crc ^= b << 8
        for _ in range(8):
            crc = ((crc << 1) ^ 0x1021) & 0xFFFF if crc & 0x8000 else (crc << 1) & 0xFFFF
    return crc


def build_header(img, uid, template=None, ver=0x10, len_value=None):
    c = crc16(img)
    h = bytearray(template) if template and len(template) >= 16 else bytearray(16)
    h[0:2] = struct.pack("<H", c)
    h[2:4] = struct.pack("<H", (~c) & 0xFFFF)
    h[4] = ver
    h[5] = (len_value if len_value is not None else (len(img) // 4)) & 0xFF
    h[6:8] = b"\xff\xff"
    h[8:12] = struct.pack("<I", uid & 0xFFFFFFFF)
    h[12:14] = b"\x00\x00"
    h[14] = 0x01
    h[15] = 0x01
    return bytes(h)


def parse_header(h):
    c0, c1, ver, ln, rfu, uid, addr, vld, typ = struct.unpack("<HHBBHIHBB", h[:16])
    return dict(crc0=c0, crc1=c1, crc_ok=(c1 == (~c0) & 0xFFFF), ver=ver, len=ln,
                rfu=rfu, uid=uid, addr=addr, vld=vld, typ=typ)


class Mario:
    def __init__(self, client, args):
        self.c = client
        self.args = args
        self.props = {}
        self.dump = {"ts": time.time(), "events": []}
        self.own_hdr = None
        self.cur = "idle"
        self.counts = defaultdict(lambda: defaultdict(int))
        self.total = 0
        self.suppressed = 0
        self.dropped = False
        self.hdr_seen = asyncio.Event()
        self.status_q = asyncio.Queue()
        self.ident_writable = False

    def on_notify(self, sender, data):
        raw = bytes(data)
        name = short(sender.uuid)
        h = raw.hex(" ")
        self.total += 1
        self.dump["events"].append({"t": time.time(), "cmd": self.cur, "ch": name, "data": h})
        n = self.counts[self.cur][h]
        self.counts[self.cur][h] = n + 1
        if n < self.args.spam_cap:
            log(f"    [{name}] {h}")
        elif n == self.args.spam_cap:
            log(f"    [{name}] {h} ...подавляю")
            self.suppressed += 1
        else:
            self.suppressed += 1
        if sender.uuid.lower() == STATUS.lower() and raw:
            self.status_q.put_nowait(raw[0])
        if sender.uuid.lower() == IDENTIFY.lower() and self.own_hdr is None and len(raw) >= 16:
            self.own_hdr = raw[:16]
            self.hdr_seen.set()
            log(f"    >>> ЗАГОЛОВОК: {raw[:16].hex(' ')}")

    async def setup(self):
        for ch in self.c.services.characteristics.values():
            self.props[ch.uuid.lower()] = list(ch.properties)
        self.ident_writable = any(p in self.props.get(IDENTIFY.lower(), [])
                                  for p in ("write", "write-without-response"))
        for u in (IDENTIFY, BLOCK, STATUS, EXTCTRL):
            try:
                await self.c.start_notify(u, self.on_notify)
            except Exception as e:
                log(f"  подписка {short(u)}: {e}")

    async def write(self, uuid, data, response=None, timeout=6.0):
        if response is None:
            response = "write" in self.props.get(uuid.lower(), [])
        try:
            await asyncio.wait_for(self.c.write_gatt_char(uuid, data, response=response), timeout)
            return True
        except asyncio.TimeoutError:
            log(f"    ! timeout {len(data)}B")
            return False
        except Exception as e:
            log(f"    ! {type(e).__name__}: {e}")
            if any(s in str(e).lower() for s in ("not connected", "disconnect", "peer removed")):
                self.dropped = True
            return False

    async def discover(self):
        log("\n[1/7 GATT]")
        for svc in self.c.services:
            log(f"  SVC {svc.uuid} {getattr(svc, 'description', '')}")
            for ch in svc.characteristics:
                log(f"    CHR {ch.uuid} props={ch.properties}")
                if "read" in ch.properties:
                    try:
                        v = await asyncio.wait_for(self.c.read_gatt_char(ch), 4.0)
                        log(f"      READ -> {bytes(v).hex(' ')}")
                    except Exception as e:
                        log(f"      READ fail: {type(e).__name__}")
        if not self.ident_writable:
            log("  !! ffc1 не пишется — прошивка недоступна, только runtime-цвет")
        if STATUS.lower() not in self.props:
            log("  !! ffc4 нет — статусы OAD не придут")

    async def probe(self):
        log("\n[2/7 ЗОНД известных кодов]")
        for cmd in KNOWN_GOOD + SILENT:
            if self.dropped:
                return
            self.cur = f"0x{cmd:02X}"
            await self.write(EXTCTRL, bytes([cmd]))
            await asyncio.sleep(self.args.delay)
            got = self.counts.get(self.cur) or {}
            log(f"  0x{cmd:02X}: " + (" | ".join(f"{h}×{n}" for h, n in got.items()) or "тишина"))
            await asyncio.sleep(self.args.delay)

    async def sweep(self):
        codes = [c for c in range(0x100) if c not in KNOWN_GOOD and c not in SILENT
                 and c <= self.args.stop_at]
        log(f"\n[3/7 ПЕРЕБОР] {len(codes)} кодов до 0x{self.args.stop_at:02X}")
        good = []
        for cmd in codes:
            if self.dropped:
                break
            self.cur = f"0x{cmd:02X}"
            await self.write(EXTCTRL, bytes([cmd]), timeout=3.0)
            await asyncio.sleep(self.args.delay)
            got = self.counts.get(self.cur) or {}
            if got and "ff" not in got:
                good.append(cmd)
                log(f"  0x{cmd:02X} ^ ОТВЕТ")
            await asyncio.sleep(self.args.delay)
        log("  новые коды: " + (" ".join(f"0x{c:02X}" for c in good) if good else "нет"))

    async def read_header(self):
        log("\n[4/7 ЗАГОЛОВОК]")
        try:
            await asyncio.wait_for(self.hdr_seen.wait(), 6.0)
        except asyncio.TimeoutError:
            pass
        if not self.own_hdr:
            log("  не пришёл")
            return False
        p = parse_header(self.own_hdr)
        log(f"  crc0={p['crc0']:04X} crc1={p['crc1']:04X} ver={p['ver']} len={p['len']} "
            f"uid={p['uid']:08X} vld={p['vld']} typ={p['typ']}")
        log(f"  crc_ok={p['crc_ok']}")
        return p["crc_ok"]

    async def green_sweep(self):
        combos = [(cmd, p) for cmd in GREEN_CMDS for p in GREEN_PAYLOADS]
        log(f"\n[5/7 ЦВЕТ] {len(combos)} комбинаций. Смотри на фигурку, запоминай номер.")
        for i, (cmd, payload) in enumerate(combos, 1):
            if self.dropped:
                return
            self.cur = f"G{i}"
            log(f"  [{i}/{len(combos)}] 0x{cmd:02X} {payload.hex(' ')}")
            await self.write(EXTCTRL, bytes([cmd]) + payload)
            await asyncio.sleep(self.args.delay)
        return combos

    async def green_cycle(self, combos):
        log("\n[HOLD] кручу все комбинации по кругу, Ctrl-C для стопа")
        while not self.dropped:
            for i, (cmd, payload) in enumerate(combos, 1):
                if self.dropped:
                    break
                log(f"  [{i}] 0x{cmd:02X} {payload.hex(' ')}")
                await self.write(EXTCTRL, bytes([cmd]) + payload, timeout=2.0)
                await asyncio.sleep(1.2)

    def patch_bytes(self, img):
        pairs = []
        for p in self.args.pair:
            a, b = p.split(":")
            pairs.append((bytes.fromhex(a.replace(" ", "")), bytes.fromhex(b.replace(" ", ""))))
        if not pairs:
            pairs = [(b"\xff\x00\x00", b"\x00\xff\x00")]
        buf = bytearray(img)
        hits = 0
        for src, dst in pairs:
            if len(src) != len(dst):
                continue
            start = 0
            while True:
                i = buf.find(src, start)
                if i < 0:
                    break
                buf[i:i + len(dst)] = dst
                hits += 1
                start = i + len(dst)
        log(f"  замен в образе: {hits}")
        return bytes(buf), hits

    async def wait_status(self, timeout):
        try:
            return await asyncio.wait_for(self.status_q.get(), timeout)
        except asyncio.TimeoutError:
            return None

    async def oad(self, path):
        img = bytearray(open(path, "rb").read())
        if not img:
            log("  пустой образ")
            return False
        if len(img) % 4:
            img += b"\xff" * (4 - len(img) % 4)
        if not self.own_hdr:
            log("  нет заголовка устройства")
            return False
        own = parse_header(self.own_hdr)
        uid = self.args.uid_int if self.args.uid_int is not None else own["uid"] ^ 0xFFFFFFFF
        hdr = build_header(bytes(img), uid, template=self.own_hdr, len_value=self.args.len_value)
        log(f"\n[7/7 OAD] {len(img)} байт, crc16 {crc16(bytes(img)):04X}")
        log(f"  uid {own['uid']:08X} -> {uid:08X}")
        log(f"  заголовок: {hdr.hex(' ')}")
        for i in range(3, 0, -1):
            log(f"  старт через {i}... Ctrl-C для отмены")
            await asyncio.sleep(1)

        if not await self.write(IDENTIFY, hdr, response=False, timeout=8.0):
            log("  заголовок не ушёл")
            return False
        st = await self.wait_status(8.0)
        log(f"  статус заголовка: {OAD_STATUS.get(st, st)}")
        if st not in (0x00, None):
            return False

        bs = self.args.block_size
        total = (len(img) + bs - 1) // bs
        log(f"  блоков {total} по {bs} B")
        t0 = time.time()
        for i in range(total):
            if self.dropped:
                return False
            chunk = bytes(img[i * bs:(i + 1) * bs])
            if not await self.write(BLOCK, struct.pack("<H", i) + chunk, response=False, timeout=6.0):
                log(f"  обрыв на блоке {i}")
                return False
            if i % 32 == 31 or i == total - 1:
                log(f"    {i + 1}/{total} {100 * (i + 1) // total}% "
                    f"{((i + 1) * bs) / max(time.time() - t0, 1e-3) / 1024:.1f} KiB/s")
            st = await self.wait_status(0.01)
            if st is not None and st != 0x00:
                log(f"  статус блока {i}: {OAD_STATUS.get(st, st)}")
                if st in (0x01, 0x02, 0x03):
                    return False

        st = await self.wait_status(20.0)
        log(f"  финал: {OAD_STATUS.get(st, st)}")
        if st == 0x00:
            log("  УСПЕХ. Фигурка в ребуте, не трогай 10 секунд.")
            return True
        return False

    async def auto(self):
        log("=== AUTO ===")
        await self.discover()
        if self.dropped:
            return
        await self.probe()
        await self.sweep()
        crc_ok = await self.read_header()

        combos = await self.green_sweep()

        fw = self.args.fw
        do_flash = self.ident_writable and crc_ok and not self.args.no_oad
        if do_flash:
            try:
                raw = open(fw, "rb").read()
            except FileNotFoundError:
                log(f"\n[6/7] файла {fw} нет — прошивку пропускаю")
                do_flash = False
            if do_flash:
                log(f"\n[6/7 ПАТЧ] {fw} -> {self.args.out}")
                patched, hits = self.patch_bytes(raw)
                if hits:
                    open(self.args.out, "wb").write(patched)
                    if await self.oad(self.args.out):
                        return
                else:
                    log("  попаданий нет, прошивку не трогаю")
        else:
            log(f"\n[6/7] прошивка недоступна "
                f"(write={self.ident_writable}, crc_ok={crc_ok}, no_oad={self.args.no_oad})")

        if combos and not self.dropped:
            await self.green_cycle(combos)

    def report(self):
        log("\n" + "=" * 50)
        log(f"нотификаций {self.total}, подавлено {self.suppressed}, "
            f"заголовок {'есть' if self.own_hdr else 'нет'}")
        log("=" * 50)
        with open(self.args.dump, "w") as f:
            json.dump(self.dump, f, indent=1)
        log(f"лог: {self.args.dump}")


async def find(args):
    for attempt in range(3):
        dev = await BleakScanner.find_device_by_filter(
            lambda d, ad: d.name and args.name.lower() in d.name.lower(), timeout=args.timeout)
        if dev:
            return dev
        log(f"  попытка {attempt + 1}/3 — не найдено, нажми кнопку на Марио")
    return None


async def run(args):
    if args.mode == "patch":
        m = Mario(None, args)
        raw = open(args.file, "rb").read()
        patched, hits = m.patch_bytes(raw)
        log(f"замен: {hits}")
        if hits and not args.dry_run:
            open(args.out, "wb").write(patched)
            log(f"записано: {args.out}, crc16 {crc16(patched):04X}")
        return 0

    log(f"режим {args.mode}")
    dev = await find(args)
    if not dev:
        log("Марио не найден")
        return 2
    log(f"найдено {dev.name} ({dev.address})")

    client = BleakClient(dev, timeout=20.0)
    await client.connect()
    m = Mario(client, args)
    try:
        await m.setup()
        if args.mode == "auto":
            await m.auto()
        elif args.mode == "discover":
            await m.discover()
        elif args.mode == "probe":
            await m.probe()
        elif args.mode == "sweep":
            await m.sweep()
        elif args.mode == "header":
            await m.read_header()
        elif args.mode == "green":
            combos = await m.green_sweep()
            if args.hold and combos:
                await m.green_cycle(combos)
        elif args.mode == "oad":
            if await m.read_header():
                await m.oad(args.file)
            else:
                log("crc_ok=False — заливка отменена")
    finally:
        m.report()
        try:
            await client.disconnect()
        except Exception:
            pass
    return 0


def main():
    p = argparse.ArgumentParser()
    p.add_argument("mode", nargs="?", default="auto",
                   choices=["auto", "discover", "probe", "sweep", "header", "green", "patch", "oad"])
    p.add_argument("file", nargs="?", help="образ для patch/oad")
    p.add_argument("--name", default="Mario")
    p.add_argument("--timeout", type=float, default=15.0)
    p.add_argument("--delay", type=float, default=0.3)
    p.add_argument("--spam-cap", type=int, default=4)
    p.add_argument("--stop-at", type=lambda x: int(x, 0), default=0x50)
    p.add_argument("--dump", default="mario_auto.json")
    p.add_argument("--yes", action="store_true")
    p.add_argument("--hold", action="store_true")
    p.add_argument("--fw", default="fw.bin")
    p.add_argument("--out", default="green.bin")
    p.add_argument("--pair", action="append", default=[])
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--block-size", type=int, default=16)
    p.add_argument("--len-value", type=lambda x: int(x, 0), default=None)
    p.add_argument("--uid-int", type=lambda x: int(x, 0), default=None)
    p.add_argument("--no-oad", action="store_true")
    args = p.parse_args()
    if args.mode in ("patch", "oad") and not args.file:
        p.error("нужен файл образа")
    try:
        sys.exit(asyncio.run(run(args)))
    except KeyboardInterrupt:
        log("\nпрервано")


if __name__ == "__main__":
    main()
Запуск — одна строка, перед ней нажми кнопку на груди Марио:

python hack_mario.py --yes
Что произойдёт по шагам: GATT-дамп → зонд известных кодов → перебор до 0x50 → снятие заголовка с проверкой CRC → перебор 120 вариантов цвета → если есть fw.bin и crc_ok=True, патч red→green и заливка → иначе бесконечная прокрутка цветов.

Если хочешь сразу прошивку, положи fw.bin в ~/mario_hack до запуска. Без него команда всё равно полезна: она соберёт всё разом и останется крутить цвета, а ты просто смотришь на фигурку и говоришь номер.

Ctrl-C в любой момент обрывает. Лог пишется в mario_auto.json.

