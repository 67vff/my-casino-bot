    /** Планируемая зона обычной трапки: 5×5×5 вокруг точки. */
    private Set<Location> plannedTrapkaZone(Location center) {
        Set<Location> planned = new HashSet<>();
        for (int x = -2; x <= 2; x++) {
            for (int y = -1; y <= 3; y++) {
                for (int z = -2; z <= 2; z++) {
                    planned.add(center.clone().add(x, y, z));
                }
            }
        }
        return planned;
    }

    private boolean overlapsAnyTrap(Set<Location> planned) {
        for (Location l : planned) {
            if (trapkaZones.contains(l) || minerTrapZones.contains(l)) return true;
        }
        return false;
    }

    private boolean isInsideAnyTrapka(Location center) {
        for (int x = -2; x <= 2; x++) {
            for (int y = -1; y <= 2; y++) {
                for (int z = -2; z <= 2; z++) {
                    if (trapkaZones.contains(center.clone().add(x, y, z))) {
                        return true;
                    }
                }
            }
        }
        return false;
    }

    private boolean isInsideMinerTrap(Location loc) {
        Location blockLoc = loc.getBlock().getLocation();
        return minerTrapZones.contains(blockLoc) || minerTrapZones.contains(blockLoc.clone().add(0, 1, 0));
    }

    private boolean isPlayerStuckInBlocks(Player player) {
        Block feetBlock = player.getLocation().getBlock();
        Block headBlock = player.getEyeLocation().getBlock();
        return (feetBlock.getType().isSolid() && feetBlock.isCollidable())
                || (headBlock.getType().isSolid() && headBlock.isCollidable())
                || player.isInsideVehicle();
    }

    private Location findNearestAirLocation(Location origin, int maxRadius) {
        World world = origin.getWorld();
        if (world == null) return null;

        int ox = origin.getBlockX();
        int oy = origin.getBlockY();
        int oz = origin.getBlockZ();
        int minY = world.getMinHeight();
        int maxY = world.getMaxHeight() - 2;

        for (int r = 1; r <= maxRadius; r++) {
            Location bestInShell = null;
            double bestDistSq = Double.MAX_VALUE;
            for (int dx = -r; dx <= r; dx++) {
                for (int dy = -r; dy <= r; dy++) {
                    int y = oy + dy;
                    if (y < minY || y > maxY) continue;
                    for (int dz = -r; dz <= r; dz++) {
                        if (Math.abs(dx) != r && Math.abs(dy) != r && Math.abs(dz) != r) continue;
                        int x = ox + dx;
                        int z = oz + dz;
                        Block b1 = world.getBlockAt(x, y, z);
                        Block b2 = world.getBlockAt(x, y + 1, z);
                        if (isSafeAir(b1) && isSafeAir(b2)) {
                            double distSq = (double) dx * dx + (double) dy * dy + (double) dz * dz;
                            if (distSq < bestDistSq) {
                                bestDistSq = distSq;
                                bestInShell = new Location(world, x + 0.5, y, z + 0.5);
                            }
                        }
                    }
                }
            }
            if (bestInShell != null) {
                return bestInShell;
            }
        }
        return null;
    }

    private boolean isSafeAir(Block b) {
        Material m = b.getType();
        return m.isAir() || (!m.isSolid() && !isLiquidMaterial(m)
                && m != Material.FIRE && m != Material.SOUL_FIRE);
    }

    private void activateHeadMiner(Player activator) {
        List<Player> detectedInvis = new ArrayList<>();
        Location center = activator.getLocation();
        int radius = cfgInt("headminer.radius", 100);

        for (Player target : activator.getWorld().getPlayers()) {
            if (target.equals(activator)) continue;
            if (target.hasPotionEffect(PotionEffectType.INVISIBILITY)
                    && target.getLocation().distanceSquared(center) <= (double) radius * radius) {
                detectedInvis.add(target);
            }
        }

        activator.getWorld().playSound(center, Sound.ENTITY_ENDER_EYE_DEATH, 1.2f, 1.2f);

        if (detectedInvis.isEmpty()) {
            activator.sendMessage(line("Невидимок рядом не найдено."));
            return;
        }

        activator.sendMessage(Component.text("Невидимок найдено: " + detectedInvis.size(), NamedTextColor.GREEN));
        ItemStack fakeHead = new ItemStack(Material.PLAYER_HEAD);
        int durationTicks = cfgInt("headminer.duration-seconds", 5) * 20;

        new BukkitRunnable() {
            int ticksElapsed = 0;

            @Override
            public void run() {
                if (ticksElapsed >= durationTicks) {
                    for (Player target : detectedInvis) {
                        if (!target.isOnline()) continue;
                        ItemStack realHelmet = target.getInventory().getHelmet();
                        for (Player viewer : target.getWorld().getPlayers()) {
                            if (!viewer.equals(target)) {
                                viewer.sendEquipmentChange(target, EquipmentSlot.HEAD, realHelmet);
                            }
                        }
                    }
                    cancel();
                    return;
                }
                for (Player target : detectedInvis) {
                    if (!target.isOnline()) continue;
                    for (Player viewer : target.getWorld().getPlayers()) {
                        if (!viewer.equals(target)) {
                            viewer.sendEquipmentChange(target, EquipmentSlot.HEAD, fakeHead);
                        }
                    }
                }
                ticksElapsed += 5;
            }
        }.runTaskTimer(this, 0L, 5L);
    }

    private boolean checkCooldown(Player player, Map<UUID, Long> map, long now, String name) {
        Long end = map.get(player.getUniqueId());
        if (end != null && end > now) {
            long sec = ((end - now) / 1000) + 1;
            sendRateLimited(player, line("Подождите ещё " + sec + " сек."));
            return true;
        }
        return false;
    }

    private void markFrozen(Location center, int rx, int ryDown, int ryUp, Set<Location> physicsBox) {
        for (int x = -rx; x <= rx; x++) {
            for (int y = -ryDown; y <= ryUp; y++) {
                for (int z = -rx; z <= rx; z++) {
                    physicsBox.add(center.clone().add(x, y, z));
                }
            }
        }
        freezePhysicsZones.addAll(physicsBox);
    }

    private void destroyOverlappingTraps(Set<Location> newZone, Player activator) {
        for (ActiveTrap trap : new ArrayList<>(activeTraps)) {
            boolean overlap = false;
            for (Location l : newZone) {
                if (trap.zone.contains(l)) {
                    overlap = true;
                    break;
                }
            }
            if (overlap) {
                restoreTrap(trap);
                if (activator != null) {
                    activator.sendMessage(Component.text("Ваша трапка снесла чужую трапку!", NamedTextColor.LIGHT_PURPLE));
                }
            }
        }
    }

    private void clearItemsInside(Location center, int rx, int ryDown, int ryUp) {
        for (Entity e : center.getWorld().getNearbyEntities(center, rx + 0.5, ryUp + 0.5, rx + 0.5)) {
            if (e instanceof Item drop) {
                Location l = drop.getLocation();
                if (Math.abs(l.getBlockX() - center.getBlockX()) <= rx
                        && l.getBlockY() - center.getBlockY() >= -ryDown
                        && l.getBlockY() - center.getBlockY() <= ryUp
                        && Math.abs(l.getBlockZ() - center.getBlockZ()) <= rx) {
                    drop.remove();
                }
            }
        }
    }

    private boolean isInZone(ActiveTrap trap, Location loc) {
        return trap.zone.contains(loc.getBlock().getLocation());
    }

    private void startBossBarTimer(ActiveTrap trap, String title, BarColor color) {
        if (trap.zone.isEmpty()) return;

        final World world = trap.zone.iterator().next().getWorld();
        if (world == null) return;

        trap.bossBar = Bukkit.createBossBar(title, color, BarStyle.SEGMENTED_10);

        for (Player p : world.getPlayers()) {
            if (isInZone(trap, p.getLocation()) || isInZone(trap, p.getEyeLocation())) {
                trap.bossBar.addPlayer(p);
            }
        }

        trap.timerTask = new BukkitRunnable() {
            @Override
            public void run() {
                long remainMs = trap.endAt - System.currentTimeMillis();
                if (remainMs <= 0) return;
                double progress = Math.max(0.0, Math.min(1.0, remainMs / (double) trap.totalMs));
                trap.bossBar.setProgress(progress);
                long sec = remainMs / 1000 + 1;
                trap.bossBar.setTitle(title + " — " + sec + "с");

                for (Player p : world.getPlayers()) {
                    boolean inside = isInZone(trap, p.getLocation()) || isInZone(trap, p.getEyeLocation());
                    boolean viewing = trap.bossBar.getPlayers().contains(p);
                    if (inside && !viewing) {
                        trap.bossBar.addPlayer(p);
                    } else if (!inside && viewing) {
                        trap.bossBar.removePlayer(p);
                    }
                }
            }
        }.runTaskTimer(this, 20L, 20L);
    }

    // ================== ОБЫЧНАЯ ТРАПКА ==================

    private void spawnTrapka(Location center) {
        long durationMs = cfgLong("trapka.duration-seconds", 30) * 1000L;
        ActiveTrap trap = new ActiveTrap(durationMs, false);

        markFrozen(center, 4, 2, 4, trap.physicsBox);

        for (int x = -2; x <= 2; x++) {
            for (int y = -1; y <= 3; y++) {
                for (int z = -2; z <= 2; z++) {
                    Location loc = center.clone().add(x, y, z);
                    if (protectedBlocks.contains(loc)) continue;

                    Block b = loc.getBlock();
                    if (isUntouchable(b.getType())) continue;

                    trap.saved.put(loc, snapshotBlock(b));
                    trap.zone.add(loc);
                    trapkaZones.add(loc);
                    b.setType(Material.AIR, false);
                }
            }
        }

        Material wallGlass = cfgMaterial("trapka.wall-material", "BLACK_STAINED_GLASS");

        for (Location loc : trap.zone) {
            int dx = loc.getBlockX() - center.getBlockX();
            int dy = loc.getBlockY() - center.getBlockY();
            int dz = loc.getBlockZ() - center.getBlockZ();
            boolean wallX = Math.abs(dx) == 2;
            boolean wallZ = Math.abs(dz) == 2;
            Block b = loc.getBlock();

            if (dy == -1 || dy == 3) {
                b.setType((wallX && wallZ) ? Material.SEA_LANTERN : Material.POLISHED_BLACKSTONE, false);
                protectedBlocks.add(loc);
            } else if (wallX || wallZ) {
                // РОВНО 1 стержень Края на стену: центр по высоте и ширине
                boolean wallCenter = (dy == 1) && ((dx == 0 && wallZ) || (dz == 0 && wallX));
                b.setType(wallCenter ? Material.END_ROD : wallGlass, false);
                protectedBlocks.add(loc);
            }
        }

        clearItemsInside(center, 2, 1, 3);

        Bukkit.getScheduler().runTaskLater(this, () -> freezePhysicsZones.removeAll(trap.physicsBox), 2L);

        // maxOffset 1.0 — сущности не выталкивает сквозь стену клетки
        teleportEntitiesInside(center.clone().add(0.5, 0.2, 0.5), 2.8, 2.8, 1.0, center.getY(), center.getY() + 1.2, 0.2);

        trap.endAt = System.currentTimeMillis() + trap.totalMs;
        startBossBarTimer(trap, "Трапка", BarColor.RED);
        activeTraps.add(trap);
        trap.restoreTask = Bukkit.getScheduler().runTaskLater(this, () -> restoreTrap(trap), durationMs / 50L);
    }

    // ================== ТРАПКА ШАХТЁРА ==================

    private void spawnMinerTrap(Location center) {
        long durationMs = cfgLong("minertrap.duration-seconds", 60) * 1000L;
        int radius = cfgInt("minertrap.radius", 4);
        ActiveTrap trap = new ActiveTrap(durationMs, true);

        Set<Location> planned = new HashSet<>();
        for (int x = -radius; x <= radius; x++) {
            for (int y = -1; y <= 5; y++) {
                for (int z = -radius; z <= radius; z++) {
                    planned.add(center.clone().add(x, y, z));
                }
            }
        }
        destroyOverlappingTraps(planned, null);

        markFrozen(center, radius + 1, 2, 6, trap.physicsBox);

        for (int x = -radius; x <= radius; x++) {
            for (int y = -1; y <= 5; y++) {
                for (int z = -radius; z <= radius; z++) {
                    Location loc = center.clone().add(x, y, z);
                    if (protectedBlocks.contains(loc)) continue;

                    Block b = loc.getBlock();
                    if (isUntouchable(b.getType())) continue;

                    trap.saved.put(loc, snapshotBlock(b));
                    trap.zone.add(loc);
                    trapkaZones.add(loc);
                    minerTrapZones.add(loc);
                    b.setType(Material.AIR, false);
                }
            }
        }

        Material wallMat = cfgMaterial("minertrap.wall-material", "PURPLE_STAINED_GLASS");
        Material cornerMat = cfgMaterial("minertrap.corner-material", "POLISHED_BLACKSTONE");
        Material floorMat = cfgMaterial("minertrap.floor-material", "CRYING_OBSIDIAN");

        for (Location loc : trap.zone) {
            int dx = loc.getBlockX() - center.getBlockX();
            int dy = loc.getBlockY() - center.getBlockY();
            int dz = loc.getBlockZ() - center.getBlockZ();
            Block b = loc.getBlock();

            if (dy == -1 || dy == 5) {
                Material mat = (dy == 5 && Math.abs(dx) % 2 == 0 && Math.abs(dz) % 2 == 0)
                        ? Material.SEA_LANTERN : floorMat;
                b.setType(mat, false);
                protectedBlocks.add(loc);
            } else if (Math.abs(dx) == radius || Math.abs(dz) == radius) {
                Material mat = (Math.abs(dx) == radius && Math.abs(dz) == radius) ? cornerMat : wallMat;
                b.setType(mat, false);
                protectedBlocks.add(loc);
            } else {
                noBuildZones.add(loc);
            }
        }

        clearItemsInside(center, radius - 1, 1, 4);

        Bukkit.getScheduler().runTaskLater(this, () -> freezePhysicsZones.removeAll(trap.physicsBox), 2L);

        teleportEntitiesInside(center.clone().add(0.5, 0.2, 0.5), radius + 0.5, 4.0, radius - 1.0,
                center.getY(), center.getY() + 3.0, 0.2);

        trap.endAt = System.currentTimeMillis() + trap.totalMs;
        startBossBarTimer(trap, "Трапка Шахтёра", BarColor.PURPLE);
        activeTraps.add(trap);
        trap.restoreTask = Bukkit.getScheduler().runTaskLater(this, () -> restoreTrap(trap), durationMs / 50L);
    }

    // ================== ПЛАТФОРМА ==================

    private void spawnPlatform(Location playerLoc) {
        Map<Location, BlockSave> saved = new HashMap<>();
        Set<Location> zone = new HashSet<>();
        Set<Location> physicsBox = new HashSet<>();

        markFrozen(playerLoc, 3, 2, 3, physicsBox);

        Material centerMat = cfgMaterial("platform.floor-material", "PEARLESCENT_FROGLIGHT");
        Material edgeMat = cfgMaterial("platform.edge-material", "CRYING_OBSIDIAN");
        Material cornerMat = cfgMaterial("platform.corner-material", "POLISHED_BLACKSTONE");
        Material rimMat = cfgMaterial("platform.rim-material", "PURPLE_STAINED_GLASS");

        for (int x = -2; x <= 2; x++) {
            for (int z = -2; z <= 2; z++) {
                Location floorLoc = playerLoc.clone().add(x, -1, z);
                if (!protectedBlocks.contains(floorLoc)) {
                    Block b = floorLoc.getBlock();
                    if (!isUntouchable(b.getType())) {
                        saved.put(floorLoc, snapshotBlock(b));
                        b.setType(Material.AIR, false);
                        if (Math.abs(x) == 2 && Math.abs(z) == 2) {
                            b.setType(cornerMat, false);
                        } else if (Math.abs(x) <= 1 && Math.abs(z) <= 1) {
                            b.setType(centerMat, false);
                        } else {
                            b.setType(edgeMat, false);
                        }
                        protectedBlocks.add(floorLoc);
                        zone.add(floorLoc);
                    }
                }

                for (int y = 0; y <= 1; y++) {
                    Location airLoc = playerLoc.clone().add(x, y, z);
                    if (y == 0 && (Math.abs(x) == 2 || Math.abs(z) == 2)) {
                        if (!protectedBlocks.contains(airLoc)) {
                            Block rim = airLoc.getBlock();
                            if (!isUntouchable(rim.getType())) {
                                saved.put(airLoc, snapshotBlock(rim));
                                rim.setType(Material.AIR, false);
                                rim.setType(rimMat, false);
                                protectedBlocks.add(airLoc);
                                zone.add(airLoc);
                            }
                        }
                    } else {
                        noBuildZones.add(airLoc);
                        zone.add(airLoc);
                    }
                }
            }
        }

        Bukkit.getScheduler().runTaskLater(this, () -> freezePhysicsZones.removeAll(physicsBox), 2L);

        teleportEntitiesInside(playerLoc.clone().add(0.5, 0.0, 0.5), 2.8, 2.5, 1.2, playerLoc.getY(), playerLoc.getY() + 2.0, 0.15);
        scheduleRestore(saved, zone, physicsBox, cfgLong("platform.duration-seconds", 15) * 20L);
    }

    private void scheduleRestore(Map<Location, BlockSave> saved, Set<Location> zone, Set<Location> physicsBox, long ticks) {
        Bukkit.getScheduler().runTaskLater(this, () -> {
            freezePhysicsZones.addAll(physicsBox);

            List<Map.Entry<Location, BlockSave>> sortedEntries = new ArrayList<>(saved.entrySet());
            sortedEntries.sort(Comparator.comparingInt(e -> e.getKey().getBlockY()));

            for (int i = sortedEntries.size() - 1; i >= 0; i--) {
                Location loc = sortedEntries.get(i).getKey();
                loc.getBlock().setType(Material.AIR, false);
                protectedBlocks.remove(loc);
            }

            for (Map.Entry<Location, BlockSave> entry : sortedEntries) {
                try {
                    BlockSave save = entry.getValue();
                    save.state.update(true, false);
                    if (save.contents != null) {
                        Block block = entry.getKey().getBlock();
                        if (block.getState() instanceof InventoryHolder holder) {
                            holder.getInventory().setContents(save.contents);
                        }
                    }
                } catch (IllegalArgumentException ignored) {
                }
            }

            noBuildZones.removeAll(zone);
            Bukkit.getScheduler().runTaskLater(this, () -> freezePhysicsZones.removeAll(physicsBox), 2L);
        }, ticks);
    }

    private void teleportEntitiesInside(Location boxCenter, double rx, double ry, double maxOffset,
                                        double minY, double maxY, double yLift) {
        for (Entity entity : boxCenter.getWorld().getNearbyEntities(boxCenter, rx, ry, rx)) {
            if (entity instanceof LivingEntity) {
                Location eLoc = entity.getLocation();
                double dx = eLoc.getX() - boxCenter.getX();
                double dz = eLoc.getZ() - boxCenter.getZ();
                double safeX = boxCenter.getX() + Math.max(-maxOffset, Math.min(maxOffset, dx));
                double safeZ = boxCenter.getZ() + Math.max(-maxOffset, Math.min(maxOffset, dz));
                double safeY = Math.max(minY + 0.1, Math.min(maxY, eLoc.getY() + yLift));
                entity.teleport(new Location(entity.getWorld(), safeX, safeY, safeZ, eLoc.getYaw(), eLoc.getPitch()));
            }
        }
    }

    // ================== ВОССТАНОВЛЕНИЕ ТРАПКИ ==================

    private void restoreTrap(ActiveTrap trap) {
        if (trap.restored) return;
        trap.restored = true;
        activeTraps.remove(trap);

        if (trap.restoreTask != null) {
            trap.restoreTask.cancel();
        }
        if (trap.timerTask != null) {
            trap.timerTask.cancel();
        }
        if (trap.bossBar != null) {
            trap.bossBar.removeAll();
        }

        freezePhysicsZones.addAll(trap.physicsBox);

        List<Map.Entry<Location, BlockSave>> sortedEntries = new ArrayList<>(trap.saved.entrySet());
        sortedEntries.sort(Comparator.comparingInt(e -> e.getKey().getBlockY()));

        for (int i = sortedEntries.size() - 1; i >= 0; i--) {
            Location loc = sortedEntries.get(i).getKey();
            loc.getBlock().setType(Material.AIR, false);
            protectedBlocks.remove(loc);
        }

        for (Map.Entry<Location, BlockSave> entry : sortedEntries) {
            try {
                BlockSave save = entry.getValue();
                save.state.update(true, false);
                if (save.contents != null) {
                    Block block = entry.getKey().getBlock();
                    if (block.getState() instanceof InventoryHolder holder) {
                        holder.getInventory().setContents(save.contents);
                    }
                }
            } catch (IllegalArgumentException ignored) {
            }
        }

        noBuildZones.removeAll(trap.zone);
        trapkaZones.removeAll(trap.zone);
        if (trap.isMinerTrap) minerTrapZones.removeAll(trap.zone);

        Bukkit.getScheduler().runTaskLater(this, () -> freezePhysicsZones.removeAll(trap.physicsBox), 2L);
    }

    // ================== ЗАЩИТА СТЕНОК, ТНТ И ДОБЫЧА СПАВНЕРОВ ==================

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onBreak(BlockBreakEvent event) {
        Block block = event.getBlock();
        Location loc = block.getLocation();
        if (protectedBlocks.contains(loc)) {
            event.setCancelled(true);
            return;
        }

        Integer tntLvl = placedMinerTnts.remove(loc);
        if (tntLvl != null && tntLvl > 0) {
            event.setDropItems(false);
            if (event.getPlayer().getGameMode() != GameMode.CREATIVE) {
                block.getWorld().dropItemNaturally(loc.add(0.5, 0.5, 0.5), createTntMiner(tntLvl));
            }
            return;
        }

        if (placedUnderwaterTnts.remove(loc)) {
            event.setDropItems(false);
            if (event.getPlayer().getGameMode() != GameMode.CREATIVE) {
                block.getWorld().dropItemNaturally(loc.add(0.5, 0.5, 0.5), createUnderwaterTntItem());
            }
            return;
        }

        Player player = event.getPlayer();
        ItemStack tool = player.getInventory().getItemInMainHand();
        int minerLvl = getMinerLevel(tool);

        if (minerLvl == 1 || minerLvl == 2) {
            if (block.getType() != Material.SPAWNER) {
                return;
            }

            event.setDropItems(false);
            event.setExpToDrop(0);

            EntityType spawnedType = null;
            if (minerLvl == 2 && block.getState() instanceof CreatureSpawner cs) {
                spawnedType = cs.getSpawnedType();
            }

            ItemStack spawnerItem = createSpawnerItemWithMob(spawnedType);
            block.getWorld().dropItemNaturally(block.getLocation().add(0.5, 0.5, 0.5), spawnerItem);

            if (player.getGameMode() != GameMode.CREATIVE) {
                tool.setAmount(tool.getAmount() - 1);
                player.playSound(player.getLocation(), Sound.ENTITY_ITEM_BREAK, 1.0f, 1.0f);
            }
        }
    }
