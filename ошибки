/**
 * Отдельный файл для прокачанных ТНТ.
 * Варианты: сила ×5 или ×10, ломает/не ломает обсидиан, работает/не работает под водой.
 * Фьюз — 5 секунд. Таймер «Взрыв через: N» прикреплён к ТНТ и едет за ней.
 */
public class TntItems implements Listener {

    // Биты флагов в PersistentDataContainer
    public static final int BIT_X10 = 1;        // ×10 (иначе ×5)
    public static final int BIT_OBSIDIAN = 2;   // ломает обсидиан
    public static final int BIT_UNDERWATER = 4; // работает под водой

    private static final int FUSE_TICKS = 5 * 20; // 5 секунд до взрыва

    private final TrapkaPlugin plugin;
    private final org.bukkit.NamespacedKey tntKey;

    // Установленные на суше блоки наших ТНТ: координата → флаги
    private final Map<Location, Integer> placedSpecialTnts = new HashMap<>();

    public TntItems(TrapkaPlugin plugin) {
        this.plugin = plugin;
        this.tntKey = new org.bukkit.NamespacedKey(plugin, "special_tnt");
        Bukkit.getPluginManager().registerEvents(this, plugin);
    }

    // ================== СОЗДАНИЕ ПРЕДМЕТОВ ==================

    public ItemStack createTnt(boolean x10, boolean obsidian, boolean underwater) {
        ItemStack item = new ItemStack(Material.TNT);
        ItemMeta meta = item.getItemMeta();
        if (meta == null) return item;

        int flags = 0;
        if (x10) flags |= BIT_X10;
        if (obsidian) flags |= BIT_OBSIDIAN;
        if (underwater) flags |= BIT_UNDERWATER;

        String base = x10 ? "Тяжёлая ТНТ" : "Мощная ТНТ";
        if (obsidian) base += " Обсидиана";
        if (underwater) base = "Подводная " + base;

        meta.displayName(ComponentX.name(base, x10
                ? net.kyori.adventure.text.format.NamedTextColor.DARK_RED
                : net.kyori.adventure.text.format.NamedTextColor.GOLD));
        int radius = x10 ? cfgRadiusX10() : cfgRadiusX5();
        meta.lore(List.of(
                ComponentX.line("Радиус разрушения: ", net.kyori.adventure.text.format.NamedTextColor.WHITE)
                        .append(ComponentX.line(radius + " блоков", net.kyori.adventure.text.format.NamedTextColor.YELLOW)),
                ComponentX.line("Обсидиан: ", net.kyori.adventure.text.format.NamedTextColor.WHITE)
                        .append(obsidian
                                ? ComponentX.line("разрушает", net.kyori.adventure.text.format.NamedTextColor.GREEN)
                                : ComponentX.line("не разрушает", net.kyori.adventure.text.format.NamedTextColor.RED)),
                ComponentX.line("Под водой: ", net.kyori.adventure.text.format.NamedTextColor.WHITE)
                        .append(underwater
                                ? ComponentX.line("работает", net.kyori.adventure.text.format.NamedTextColor.GREEN)
                                : ComponentX.line("не работает", net.kyori.adventure.text.format.NamedTextColor.GRAY)),
                ComponentX.line("Сила: ×" + (x10 ? 10 : 5) + " от обычной. Взрыв через 5 сек.",
                        net.kyori.adventure.text.format.NamedTextColor.AQUA)
        ));

        meta.getPersistentDataContainer().set(tntKey, PersistentDataType.INTEGER, flags);
        item.setItemMeta(meta);
        return item;
    }

    /** Выдача по короткому идентификатору для команд: tnt5, tnt5o, tnt5w, tnt5ow, tnt10, tnt10o, tnt10w, tnt10ow */
    public ItemStack getItem(String id) {
        switch (id.toLowerCase()) {
            case "tnt5" -> { return createTnt(false, false, false); }
            case "tnt5o" -> { return createTnt(false, true, false); }
            case "tnt5w" -> { return createTnt(false, false, true); }
            case "tnt5ow" -> { return createTnt(false, true, true); }
            case "tnt10" -> { return createTnt(true, false, false); }
            case "tnt10o" -> { return createTnt(true, true, false); }
            case "tnt10w" -> { return createTnt(true, false, true); }
            case "tnt10ow" -> { return createTnt(true, true, true); }
            default -> { return null; }
        }
    }

    // ================== ПРОВЕРКИ ==================

    private boolean isSpecialTnt(ItemStack item) {
        return item != null && item.getType() == Material.TNT && item.hasItemMeta()
                && item.getItemMeta().getPersistentDataContainer().has(tntKey, PersistentDataType.INTEGER);
    }

    private int getFlags(ItemStack item) {
        Integer f = item.getItemMeta().getPersistentDataContainer().get(tntKey, PersistentDataType.INTEGER);
        return f != null ? f : 0;
    }

    private int getFlags(TNTPrimed tnt) {
        Integer f = tnt.getPersistentDataContainer().get(tntKey, PersistentDataType.INTEGER);
        return f != null ? f : 0;
    }

    private int cfgRadiusX10() { return plugin.getConfig().getInt("special-tnt.radius-x10", 8); }
    private int cfgRadiusX5() { return plugin.getConfig().getInt("special-tnt.radius-x5", 5); }

    private boolean isLiquid(Material m) {
        return m == Material.WATER || m == Material.LAVA || m == Material.BUBBLE_COLUMN;
    }

    private boolean isObsidianFamily(Material m) {
        return m == Material.OBSIDIAN || m == Material.CRYING_OBSIDIAN;
    }

    // ================== УСТАНОВКА ==================

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onPlace(BlockPlaceEvent event) {
        ItemStack hand = event.getItemInHand();
        if (!isSpecialTnt(hand)) return;

        Block target = event.getBlockPlaced();

        if (isLiquid(target.getType())) {
            // Подводная ТНТ: блока нет, сразу подожжённая сущность — вода не «съедается»
            if ((getFlags(hand) & BIT_UNDERWATER) != 0) {
                event.setCancelled(true);
                if (event.getPlayer().getGameMode() != GameMode.CREATIVE) {
                    hand.setAmount(hand.getAmount() - 1);
                }
                spawnPrimed(target.getLocation().add(0.5, 0.1, 0.5), getFlags(hand));
            }
            // Не-подводная ТНТ в воде ставится как обычный блок — взрыв вода погасит
            return;
        }

        // На суше ваниль ставит блок сами — только запоминаем место
        placedSpecialTnts.put(target.getLocation(), getFlags(hand));
    }

    // ================== ПОДЖИГ ==================

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onPrime(TNTPrimeEvent event) {
        Location loc = event.getBlock().getLocation();
        Integer flags = placedSpecialTnts.remove(loc);
        if (flags == null) return;

        event.setCancelled(true);
        event.getBlock().setType(Material.AIR, false);
        spawnPrimed(loc.clone().add(0.5, 0.0, 0.5), flags);
    }

    // Ваниль не поджигает ТНТ в воде огнивом — поджигаем сами по клику
    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onIgniteClick(PlayerInteractEvent event) {
        if (event.getAction() != Action.RIGHT_CLICK_BLOCK) return;
        ItemStack hand = event.getItem();
        if (hand == null) return;
        Material handType = hand.getType();
        if (handType != Material.FLINT_AND_STEEL && handType != Material.FIRE_CHARGE) return;

        Block clicked = event.getClickedBlock();
        if (clicked == null) return;
        Integer flags = placedSpecialTnts.remove(clicked.getLocation());
        if (flags == null) return;

        event.setCancelled(true);
        clicked.setType(Material.AIR, false);
        spawnPrimed(clicked.getLocation().add(0.5, 0.0, 0.5), flags);

        if (handType == Material.FLINT_AND_STEEL
                && event.getPlayer().getGameMode() != GameMode.CREATIVE
                && hand.getItemMeta() instanceof org.bukkit.inventory.meta.Damageable dmg) {
            dmg.setDamage(dmg.getDamage() + 1);
            hand.setItemMeta(dmg);
        }
    }

    private void spawnPrimed(Location loc, int flags) {
        TNTPrimed tnt = loc.getWorld().spawn(loc, TNTPrimed.class);
        tnt.setFuseTicks(FUSE_TICKS);
        tnt.getPersistentDataContainer().set(tntKey, PersistentDataType.INTEGER, flags);
        tnt.getWorld().playSound(loc, Sound.ENTITY_TNT_PRIMED, 1.0f, 0.9f);
        startFuseTimer(tnt, flags);
    }

    // ================== ТАЙМЕР «ВЗРЫВ ЧЕРЕЗ: N» ==================

    private void startFuseTimer(TNTPrimed tnt, int flags) {
        TextDisplay display = tnt.getWorld().spawn(
                tnt.getLocation().add(0, 1.7, 0), TextDisplay.class, d -> {
                    d.setText("Взрыв через: 5");
                    d.setBillboard(Display.Billboard.CENTER);
                    d.setSeeThrough(true);
                    d.setPersistent(false);
                    d.setTransformation(new Transformation(
                            new Vector3f(0, 0, 0), new AxisAngle4f(),
                            new Vector3f(3f, 3f, 3f), new AxisAngle4f()));
                });

        new BukkitRunnable() {
            @Override
            public void run() {
                if (!tnt.isValid() || tnt.isDead()) {
                    if (display.isValid()) display.remove();
                    cancel();
                    return;
                }
                display.teleport(tnt.getLocation().add(0, 1.7, 0));
                int remain = (int) Math.ceil(tnt.getFuseTicks() / 20.0);
                display.setText(remain > 0 ? "Взрыв через: " + remain : "Взрыв!");
            }
        }.runTaskTimer(plugin, 0L, 1L);
    }

    // ================== ВЗРЫВ ==================

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onExplode(EntityExplodeEvent event) {
        if (!(event.getEntity() instanceof TNTPrimed tnt)) return;
        int flags = getFlags(tnt);
        if (flags == 0) return;

        event.blockList().clear();

        boolean underwater = (flags & BIT_UNDERWATER) != 0;
        Location center = tnt.getLocation();
        World world = center.getWorld();
        if (world == null) return;

        // Не-подводная ТНТ в воде не ломает блоки
        if (isLiquid(center.getBlock().getType()) && !underwater) return;

        int radius = (flags & BIT_X10) != 0 ? cfgRadiusX10() : cfgRadiusX5();
        boolean breaksObsidian = (flags & BIT_OBSIDIAN) != 0;

        int cx = center.getBlockX();
        int cy = center.getBlockY();
        int cz = center.getBlockZ();

        List<Location> broken = new ArrayList<>();

        for (int dx = -radius; dx <= radius; dx++) {
            for (int dy = -radius; dy <= radius; dy++) {
                for (int dz = -radius; dz <= radius; dz++) {
                    if ((double) dx * dx + (double) dy * dy + (double) dz * dz > (double) radius * radius) continue;
                    Block b = world.getBlockAt(cx + dx, cy + dy, cz + dz);
                    Material m = b.getType();
                    if (m.isAir() || isLiquid(m)) continue;
                    if (m == Material.BEDROCK) continue;
                    if (isObsidianFamily(m) && !breaksObsidian) continue;
                    if (plugin.isBlockProtected(b.getLocation())) continue;
                    event.blockList().add(b);
                    broken.add(b.getLocation());
                }
            }
        }

        // Вода возвращается моментально (на следующий тик после взрыва)
        if (!broken.isEmpty() && underwater) {
            List<BlockFace> faces = List.of(BlockFace.UP, BlockFace.DOWN,
                    BlockFace.NORTH, BlockFace.SOUTH, BlockFace.EAST, BlockFace.WEST);
            Bukkit.getScheduler().runTaskLater(plugin, () -> {
                for (Location l : broken) {
                    Block b = l.getBlock();
                    if (!b.getType().isAir()) continue;
                    for (BlockFace f : faces) {
                        Material n = b.getRelative(f).getType();
                        if (n == Material.WATER || n == Material.BUBBLE_COLUMN) {
                            b.setType(Material.WATER, false);
                            break;
                        }
                    }
                }
            }, 1L);
        }
    }

    // Усиленный урон: ×10 → ×2 к базовому урону ТНТ, ×5 → ×1.5
    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onDamage(EntityDamageByEntityEvent event) {
        if (!(event.getDamager() instanceof TNTPrimed tnt)) return;
        int flags = getFlags(tnt);
        if (flags == 0) return;
        event.setDamage(event.getDamage() * ((flags & BIT_X10) != 0 ? 2.0 : 1.5));
    }
}
