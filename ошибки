    @EventHandler
    public void onUse(PlayerInteractEvent event) {
        ItemStack item = event.getItem();
        if (item == null) return;

        Player player = event.getPlayer();
        UUID uuid = player.getUniqueId();
        long now = System.currentTimeMillis();

        if (event.getAction() != Action.RIGHT_CLICK_AIR && event.getAction() != Action.RIGHT_CLICK_BLOCK) return;

        if (isUnderwaterTnt(item) || getTntMinerLevel(item) > 0) return;

        if (isMinerCart(item)) {
            if (event.getAction() != Action.RIGHT_CLICK_BLOCK) return;
            Block clicked = event.getClickedBlock();
            if (clicked == null) return;
            event.setCancelled(true);

            if (!clicked.getType().name().endsWith("RAIL")) {
                sendRateLimited(player, line("Вагонетку нужно ставить на рельсы!"));
                return;
            }
            int lvl = getMinerCartLevel(item);
            if (lvl <= 0) return;

            if (player.getGameMode() != GameMode.CREATIVE) {
                item.setAmount(item.getAmount() - 1);
            }
            ExplosiveMinecart mc = clicked.getWorld().spawn(
                    clicked.getLocation().add(0.5, 0.0, 0.5), ExplosiveMinecart.class);
            mc.setFuseTicks(Integer.MAX_VALUE);
            mc.getPersistentDataContainer().set(tntMinerKey, PersistentDataType.INTEGER, lvl);
            player.getWorld().playSound(player.getLocation(), Sound.BLOCK_DISPENSER_DISPENSE, 1.0f, 1.0f);
            return;
        }

        Location playerBlockLoc = player.getLocation().getBlock().getLocation();

        if (isShulkerItem(item)) {
            event.setCancelled(true);
            event.setUseItemInHand(Event.Result.DENY);
            event.setUseInteractedBlock(Event.Result.DENY);
            if (!(item.getItemMeta() instanceof BlockStateMeta meta)
                    || !(meta.getBlockState() instanceof ShulkerBox box)) return;

            Inventory inv = Bukkit.createInventory(null, 27, Component.text("Шалкер"));
            inv.setContents(box.getInventory().getContents());
            openShulkers.put(uuid, inv);
            player.openInventory(inv);
            player.getWorld().playSound(player.getLocation(), Sound.BLOCK_SHULKER_BOX_OPEN, 1.0f, 1.0f);
        }
        else if (isTrapka(item)) {
            event.setCancelled(true);
            event.setUseItemInHand(Event.Result.DENY);
            event.setUseInteractedBlock(Event.Result.DENY);

            if (overlapsAnyTrap(plannedTrapkaZone(playerBlockLoc))) {
                sendRateLimited(player, line("Нельзя ставить трапку на другую трапку!"));
                return;
            }
            if (checkCooldown(player, trapkaCooldowns, now, "трапки")) return;

            long cd = cfgLong("trapka.cooldown-seconds", 30) * 1000L;
            trapkaCooldowns.put(uuid, now + cd);
            player.setCooldown(Material.NETHERITE_SCRAP, (int) (cd / 50));
            item.setAmount(item.getAmount() - 1);

            spawnTrapka(playerBlockLoc);
            player.getWorld().playSound(player.getLocation(), Sound.BLOCK_ANVIL_PLACE, 1.0f, 1.0f);
        }
        else if (isMinerTrap(item)) {
            event.setCancelled(true);
            event.setUseItemInHand(Event.Result.DENY);
            event.setUseInteractedBlock(Event.Result.DENY);
            if (checkCooldown(player, minerTrapCooldowns, now, "Трапки Шахтёра")) return;

            long cd = cfgLong("minertrap.cooldown-seconds", 60) * 1000L;
            minerTrapCooldowns.put(uuid, now + cd);
            player.setCooldown(Material.CRYING_OBSIDIAN, (int) (cd / 50));
            item.setAmount(item.getAmount() - 1);

            spawnMinerTrap(playerBlockLoc);
            player.getWorld().playSound(player.getLocation(), Sound.ENTITY_WITHER_SPAWN, 0.8f, 1.2f);
        }
        else if (isPlatform(item)) {
            event.setCancelled(true);
            event.setUseItemInHand(Event.Result.DENY);
            event.setUseInteractedBlock(Event.Result.DENY);
            if (isInsideAnyTrapka(playerBlockLoc) || isInsideMinerTrap(player.getLocation())) {
                sendRateLimited(player, line("Нельзя активировать платформу внутри трапки!"));
                return;
            }
            if (checkCooldown(player, platformCooldowns, now, "платформы")) return;

            long cd = cfgLong("platform.cooldown-seconds", 10) * 1000L;
            platformCooldowns.put(uuid, now + cd);
            player.setCooldown(Material.POLISHED_BLACKSTONE_SLAB, (int) (cd / 50));
            item.setAmount(item.getAmount() - 1);

            spawnPlatform(playerBlockLoc);
            player.getWorld().playSound(player.getLocation(), Sound.BLOCK_AMETHYST_BLOCK_CHIME, 1.2f, 1.0f);
        }
        else if (isHeadMiner(item)) {
            event.setCancelled(true);
            event.setUseItemInHand(Event.Result.DENY);
            event.setUseInteractedBlock(Event.Result.DENY);
            if (checkCooldown(player, headMinerCooldowns, now, "Головы Шахтёра")) return;

            int cd = cfgInt("headminer.cooldown-seconds", 8);
            headMinerCooldowns.put(uuid, now + cd * 1000L);
            player.setCooldown(Material.PLAYER_HEAD, cd * 20);
            activateHeadMiner(player);
        }
        else if (isMightyForce(item)) {
            event.setCancelled(true);
            event.setUseItemInHand(Event.Result.DENY);
            event.setUseInteractedBlock(Event.Result.DENY);
            if (checkCooldown(player, mightyForceCooldowns, now, "Могучей силы")) return;

            if (!isPlayerStuckInBlocks(player)) {
                sendRateLimited(player, line("Вы не застряли в блоках!"));
                return;
            }

            Location nearestAir = findNearestAirLocation(player.getLocation(), cfgInt("mightyforce.search-radius", 100));
            if (nearestAir == null) {
                sendRateLimited(player, line("В радиусе не найдено свободного воздуха!"));
                return;
            }

            int cd = cfgInt("mightyforce.cooldown-seconds", 15);
            mightyForceCooldowns.put(uuid, now + cd * 1000L);
            player.setCooldown(Material.FIRE_CHARGE, cd * 20);

            nearestAir.setYaw(player.getLocation().getYaw());
            nearestAir.setPitch(player.getLocation().getPitch());
            player.teleport(nearestAir);
            player.getWorld().playSound(nearestAir, Sound.ITEM_FIRECHARGE_USE, 1.2f, 1.2f);
            player.sendMessage(Component.text("Могучая сила вывела вас на свободный воздух!", NamedTextColor.GREEN));
        }
    }

