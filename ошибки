recon_mario.py — рекон самописного BLE-протокола поверх UUID-ов TI OAD.
python3 recon_mario.py discover --yes
python3 recon_mario.py probe --yes
python3 recon_mario.py sweep --yes --stop-at 0x50
python3 recon_mario.py attack --yes
"""

import argparse
import asyncio
import json
import random
import struct
import sys
import time
from collections import defaultdict
from bleak import BleakScanner, BleakClient

IDENTIFY = "f000ffc1-0451-4000-b000-000000000000"
BLOCK = "f000ffc2-0451-4000-b000-000000000000"
STATUS = "f000ffc4-0451-4000-b000-000000000000"
EXTCTRL = "f000ffc5-0451-4000-b000-000000000000"

NAMES = {IDENTIFY.lower(): "IDENT", BLOCK.lower(): "BLOCK",
STATUS.lower(): "STATUS", EXTCTRL.lower(): "EXT"}

KNOWN_GOOD = [0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x10, 0x11, 0x13]
SILENT = [0x28]

def short(u):
return NAMES.get(u.lower(), u[:8])

def log(m=""):
print(m, flush=True)

class Session:
def init(self, client, args):
self.c = client
self.args = args
self.rng = random.Random(args.seed)
self.props = {}
self.dump = {"ts": time.time(), "events": []}
self.own_hdr = None
self.cur = "idle"
self.counts = defaultdict(lambda: defaultdict(int))
self.total = 0
self.suppressed = 0
self.dropped = False

def on_notify(self, sender, data):
    raw = bytes(data)
    name = short(sender.uuid)
    h = raw.hex(" ")
    self.total += 1
    self.dump["events"].append({"t": time.time(), "cmd": self.cur, "ch": name, "data": h})

    n = self.counts[self.cur][h]
    self.counts[self.cur][h] = n + 1
    if n < self.args.spam_cap:
        log(f"    [{name}] {h}")
    elif n == self.args.spam_cap:
        log(f"    [{name}] {h} ...дальше подавляю")
        self.suppressed += 1
    else:
        self.suppressed += 1

    if sender.uuid.lower() == IDENTIFY.lower() and self.own_hdr is None and len(raw) >= 16:
        self.own_hdr = raw[:16]
        log(f"    >>> ЗАГОЛОВОК УСТРОЙСТВА: {raw[:16].hex(' ')}")

async def setup(self):
    for ch in self.c.services.characteristics.values():
        self.props[ch.uuid.lower()] = list(ch.properties)
    for u in (IDENTIFY, BLOCK, EXTCTRL):
        try:
            await self.c.start_notify(u, self.on_notify)
        except Exception as e:
            log(f"  подписка {short(u)}: {e}")

async def write(self, uuid, data, response=None, timeout=6.0):
    if response is None:
        response = "write" in self.props.get(uuid.lower(), [])
    try:
        await asyncio.wait_for(self.c.write_gatt_char(uuid, data, response=response), timeout)
        return True
    except asyncio.TimeoutError:
        log(f"    ! timeout {len(data)}B")
        return False
    except Exception as e:
        log(f"    ! {type(e).__name__}: {e}")
        if any(s in str(e).lower() for s in ("not connected", "disconnect", "peer removed")):
            self.dropped = True
        return False

def summarise(self, cmd):
    got = self.counts.get(self.cur)
    if not got:
        log("    (тишина)")
        return
    parts = [f"{h}{'×' + str(n) if n > 1 else ''}" for h, n in got.items()]
    log(f"    ИТОГ 0x{cmd:02X}: " + " | ".join(parts))

async def discover(self):
    log("\n[GATT] полный дамп")
    for svc in self.c.services:
        log(f"  SVC {svc.uuid}  ({svc.description})")
        for ch in svc.characteristics:
            log(f"    CHR {ch.uuid}  props={ch.properties} handle={ch.handle}")
            for d in ch.descriptors:
                log(f"      DSC {d.uuid}")
            if "read" in ch.properties:
                try:
                    val = await asyncio.wait_for(self.c.read_gatt_char(ch), 4.0)
                    log(f"      READ -> {bytes(val).hex(' ')}")
                except Exception as e:
                    log(f"      READ fail: {type(e).__name__}: {e}")

    log("\n[ВЫВОД]")
    for u, p in self.props.items():
        log(f"  {short(u):6} props={p}")
    if "write" not in self.props.get(IDENTIFY.lower(), []):
        log("  !! IDENT без свойства write — 16-байтовые заголовки могут не лечь")
    if STATUS.lower() not in self.props:
        log("  !! STATUS отсутствует — статус образа снимать неоткуда")

async def probe(self, codes):
    log(f"\n[ЗОНД] {len(codes)} кодов, лимит {self.args.spam_cap} на ответ")
    for cmd in codes:
        if self.dropped:
            log("  связь потеряна")
            return
        self.cur = f"0x{cmd:02X}"
        log(f"  0x{cmd:02X}")
        await self.write(EXTCTRL, bytes([cmd]))
        await asyncio.sleep(self.args.delay)
        self.summarise(cmd)
        await asyncio.sleep(self.args.delay)

async def sweep(self):
    codes = [c for c in range(0x100) if c not in KNOWN_GOOD and c not in SILENT]
    if self.args.stop_at is not None:
        codes = [c for c in codes if c <= self.args.stop_at]
    log(f"\n[ПЕРЕБОР] {len(codes)} кодов")
    good = []
    for cmd in codes:
        if self.dropped:
            break
        self.cur = f"0x{cmd:02X}"
        log(f"  0x{cmd:02X}")
        await self.write(EXTCTRL, bytes([cmd]), timeout=3.0)
        await asyncio.sleep(self.args.delay)
        got = self.counts.get(self.cur) or {}
        if got and "ff" not in got:
            good.append(cmd)
            log("    ^ ОТВЕТ")
        await asyncio.sleep(self.args.delay)
    if good:
        log("\n[НОВЫЕ КОДЫ] " + " ".join(f"0x{c:02X}" for c in good))
    else:
        log("\n[НОВЫЕ КОДЫ] нет")

def uid(self):
    if self.args.uid:
        return bytes.fromhex(self.args.uid.replace(" ", ""))[:4]
    if self.own_hdr:
        return self.own_hdr[:4]
    return bytes([0x4C, 0x49, 0x46, 0x55])

def hdr(self, bid, crc, length, uid=None, meta=0x0100):
    u = uid if uid is not None else self.uid()
    return (bytes(u) + struct.pack("<H", bid & 0xFFFF)
            + struct.pack("<HH", crc & 0xFFFF, (~crc) & 0xFFFF)
            + struct.pack("<I", length & 0xFFFFFFFF) + struct.pack("<H", meta))

async def attack_header(self):
    if "write" not in self.props.get(IDENTIFY.lower(), []):
        log("  IDENT без write — пробую всё равно")
    own_bid = struct.unpack("<H", self.own_hdr[4:6])[0] if self.own_hdr else 0
    bid = self.args.bid if self.args.bid is not None else own_bid ^ 0xFFFF
    cases = [
        ("нули", bytes(16)),
        ("0xFF", b"\xFF" * 16),
        ("чужой UID", b"\xDE\xAD\xBE\xEF" + bytes(12)),
        ("свой BID (отклонят)", self.hdr(own_bid, 0x1234, 0x1000)),
        ("валидный, len=0", self.hdr(bid, 0x1234, 0)),
        ("валидный, len=0xFFFFFFFF", self.hdr(bid, 0x1234, 0xFFFFFFFF)),
        ("валидный, len=0x1000", self.hdr(bid, 0x1234, 0x1000)),
    ]
    for i in range(self.args.random_headers):
        cases.append((f"рандом{i}", bytes(self.rng.getrandbits(8) for _ in range(16))))
    for name, data in cases:
        if self.dropped:
            return
        self.cur = f"HDR {name}"
        log(f"  {name}: {data.hex(' ')}")
        await self.write(IDENTIFY, data)
        await asyncio.sleep(self.args.delay * 2)

async def attack_blocks(self):
    seq = [0x0000, 0x0001, 0x0002, 0xFFFF, 0x8000, 0x0000, 0x0000, 0x0001]
    for bn in seq:
        if self.dropped:
            return
        self.cur = f"BLK {bn:04X}"
        log(f"  блок 0x{bn:04X}")
        await self.write(BLOCK, struct.pack("<H", bn) + b"\xFF" * 16)
        await asyncio.sleep(self.args.delay)
    log("  без номера блока (16B)")
    for _ in range(4):
        await self.write(BLOCK, b"\xFF" * 16)
        await asyncio.sleep(self.args.delay)

async def attack_kill(self):
    log("  финальный обрыв")
    self.cur = "KILL"
    await self.write(EXTCTRL, bytes([0x01]), response=False, timeout=1.0)
    try:
        await self.c.disconnect()
    except Exception:
        pass
    self.dropped = True

def report(self):
    log("\n" + "=" * 60)
    log(f"нотификаций {self.total}, подавлено {self.suppressed}, "
        f"UID {'захвачен' if self.own_hdr else 'НЕ захвачен'}, "
        f"обрыв {'ДА' if self.dropped else 'нет'}")
    log("=" * 60)
    if self.args.dump:
        with open(self.args.dump, "w") as f:
            json.dump(self.dump, f, indent=1)
        log(f"лог: {self.args.dump}")
async def run(args):
log(f"seed {args.seed} | режим {args.mode}")
dev = await BleakScanner.find_device_by_filter(
lambda d, ad: d.name and args.name.lower() in d.name.lower(), timeout=args.timeout)
if not dev:
log("не найдено")
return 2
log(f"найдено {dev.name} ({dev.address})")
if not args.yes:
await asyncio.get_event_loop().run_in_executor(None, input, "Enter... ")

client = BleakClient(dev, timeout=20.0)
await client.connect()
s = Session(client, args)
try:
    await s.setup()
    if args.mode == "discover":
        await s.discover()
    elif args.mode == "probe":
        await s.probe(KNOWN_GOOD + SILENT)
    elif args.mode == "sweep":
        await s.sweep()
    elif args.mode == "attack":
        await s.attack_header()
        if args.attack_blocks:
            await s.attack_blocks()
        if args.attack_kill:
            await s.attack_kill()
finally:
    s.report()
    try:
        await client.disconnect()
    except Exception:
        pass
return 0
def main():
p = argparse.ArgumentParser()
p.add_argument("mode", choices=["discover", "probe", "sweep", "attack"])
p.add_argument("--name", default="Mario")
p.add_argument("--timeout", type=float, default=15.0)
p.add_argument("--delay", type=float, default=0.25)
p.add_argument("--spam-cap", type=int, default=6)
p.add_argument("--stop-at", type=lambda x: int(x, 0), default=None)
p.add_argument("--seed", type=int, default=None)
p.add_argument("--uid", default=None)
p.add_argument("--bid", type=lambda x: int(x, 0), default=None)
p.add_argument("--random-headers", type=int, default=6)
p.add_argument("--attack-blocks", action="store_true")
p.add_argument("--attack-kill", action="store_true")
p.add_argument("--dump", default=None)
p.add_argument("--yes", action="store_true")
args = p.parse_args()
if args.seed is None:
args.seed = int(time.time()) & 0xFFFF
log(f"seed {args.seed}")
if args.dump is None:
args.dump = f"mario_{args.mode}_{int(time.time())}.json"
try:
sys.exit(asyncio.run(run(args)))
except KeyboardInterrupt:
log("\nпрервано")

